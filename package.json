{
  "name": "kennethharoldpanis",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "node --experimental-strip-types --no-warnings scripts/check-taxonomy.mjs && node scripts/generate-cover-backdrops.mjs && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "check:tokens": "node scripts/check-design-tokens.mjs",
    "check:taxonomy": "node --experimental-strip-types --no-warnings scripts/check-taxonomy.mjs",
    "check:output": "node scripts/check-home-performance.mjs && node scripts/check-release-control.mjs",
    "test": "node --experimental-strip-types --test scripts/test-cover-runtime.mjs",
    "verify": "pnpm check && pnpm check:tokens && pnpm test && pnpm build && pnpm check:output",
    "sync-notes": "node scripts/sync-patch-notes.mjs",
    "optimize-images": "node scripts/optimize-images.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/mdx": "^4.1.0",
    "@astrojs/node": "^9.1.2",
    "@astrojs/react": "^4.2.1",
    "@chenglou/pretext": "^0.0.8",
    "@nanostores/query": "^0.3.4",
    "@nanostores/react": "^1.1.0",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-select": "^2.2.6",
    "@supabase/supabase-js": "^2.87.1",
    "@tailwindcss/vite": "^4.1.12",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "astro": "^5.4.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "nanostores": "^1.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^6.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.9.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "sharp": "^0.34.4"
  }
