{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "baseUrl": ".",
    "paths": {
      "@app/*": ["src/app/*"],
      "@ui": ["lib/khp-ui/index.ts"],
      "@ui/*": ["lib/khp-ui/*"]
    }
  }
}
