---
/**
 * Prose engine, the default article renderer.
 *
 * Renders the post's markdown <Content /> through the shared ArticleLayout +
 * Prose pipeline. This is the behaviour every blog post had before engines
 * existed, extracted so the slug page can dispatch by engine.
 */
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import { calculateReadTime } from "../../utils";
import type { CollectionEntry } from "astro:content";

interface Props {
  entry: CollectionEntry<"blog">;
  Content: any;
}

const { entry, Content } = Astro.props;
const fm = entry.data;
const readTime = calculateReadTime(entry.body);
---

<ArticleLayout
  title={fm.title}
  description={fm.description}
  heroImage={fm.image}
  date={fm.pubDate}
  readTime={readTime}
  tags={fm.tags}
  tech={fm.tech}
>
  <Content />
</ArticleLayout>
