---
const { currentPage, disablePrevious, disableNext } = Astro.props;

interface Props {
  currentPage: number;
  totalPages: number;
  disablePrevious: boolean;
  disableNext: boolean;
}
---
<div class="flex justify-between mt-10">
  <a href={'/articles?page=' + (currentPage - 1)} class={
    disablePrevious ? "inline-block bg-gray-100 px-3 py-2 text-gray-400 pointer-events-none" : "inline-block bg-gray-100 px-3 py-2 hover:bg-black hover:text-white"
  }>
    Previous
  </a>
  <a href={'/articles?page=' + (currentPage + 1)} 
    class={
      disableNext ? "inline-block bg-gray-100 px-3 py-2 text-gray-400 pointer-events-none" : "inline-block bg-gray-100 px-3 py-2 hover:bg-black hover:text-white"
    }>
    Next
  </a>
</div>