---
/**
 * Cover, the cover slot for an entry card.
 *
 * Keyed off the entry's `engine` (its "type"): engines flagged with a live
 * cover (e.g. pretext) render an interactive demo in place of the image;
 * everything else renders the normal static image. One place decides this, so
 * cards never branch on the engine themselves.
 */
import { PretextCover } from "../article";
import { engineHasLiveCover } from "@/lib/engines";

interface Props {
  /** Engine / type that decides how the cover renders. */
  engine?: string | null;
  /** Image filename under /public/images (used when there's no live cover). */
  image?: string;
  title: string;
  /** "featured" is bigger (wide hero card / article); "default" is the grid. */
  variant?: "default" | "featured";
  loading?: "eager" | "lazy";
}

const { engine, image, title, variant = "default", loading = "lazy" } = Astro.props;
const live = engineHasLiveCover(engine);
---

{live ? (
  <div class="w-full aspect-video">
    <PretextCover client:visible title={title} variant={variant} />
  </div>
) : (
  <div class="relative w-full aspect-video overflow-hidden bg-neutral-950">
    <img
      src={`/images/${image}`}
      alt=""
      aria-hidden="true"
      class="absolute inset-0 w-full h-full object-cover scale-110 blur-2xl opacity-70"
      loading={loading}
    />
    <img
      src={`/images/${image}`}
      alt={title}
      class="relative w-full h-full object-contain"
      loading={loading}
    />
  </div>
)}
