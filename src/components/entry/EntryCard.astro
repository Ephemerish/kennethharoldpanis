---
/**
 * EntryCard, the ONE card for blog posts and projects.
 *
 * `kind`     "blog" | "project", which collection the entry is from
 * `variant`  "default" | "featured"
 *              default  = grid card (used in listings/grids)
 *              featured = full-width hero card (the lead/featured slot)
 *
 * One component so blog and project cards stay identical in structure and
 * styling. Kind-specific bits (status vs read-time, description, links) are
 * the only differences. Change the look here once and everything follows.
 */
import { formatDate, calculateReadTime } from "@/lib/utils";
import type { CollectionEntry } from "astro:content";
import { getTagLabel } from "@/data/tags";
import Cover from "./Cover.astro";
import Tags from "./Tags.astro";
import {
  CalendarBlankIcon as CalendarIcon,
  ClockIcon,
  ArrowRightIcon,
  GithubLogoIcon as GithubIcon,
  StarIcon,
  RocketLaunchIcon,
  BookOpenIcon,
} from "@phosphor-icons/react";

interface Props {
  entry: CollectionEntry<"blog"> | CollectionEntry<"projects">;
  kind: "blog" | "project";
  variant?: "default" | "featured";
}

const { entry, kind, variant = "default" } = Astro.props;
const isBlog = kind === "blog";

const title = entry.data.title;
const image = entry.data.image;
const tags = entry.data.tags ?? [];
const href = `${isBlog ? "/blogs" : "/projects"}/${entry.slug}`;

const blog = isBlog ? (entry.data as CollectionEntry<"blog">["data"]) : null;
const project = !isBlog ? (entry.data as CollectionEntry<"projects">["data"]) : null;
const readTime = isBlog ? calculateReadTime(entry.body) : null;

const statusText = {
  completed: "Completed",
  "in-progress": "In Progress",
  planned: "Planned",
};
const statusClass = {
  completed: "bg-success-100/95 text-success-800 border-success-200",
  "in-progress": "bg-warning-100/95 text-warning-800 border-warning-200",
  planned: "bg-neutral-100/95 text-neutral-700 border-neutral-200",
};
const date = isBlog ? blog!.pubDate : project!.endDate ?? project!.startDate;
// The engine ("type") tells <Cover /> how to render: live demo vs static image.
const coverEngine = isBlog ? blog!.engine : undefined;
const ctaLabel = isBlog ? "Read post" : "View project";
const KindIcon = isBlog ? BookOpenIcon : RocketLaunchIcon;
const kindLabel = isBlog ? "Latest post" : "Latest project";
---

{variant === "featured" ? (
  <article class="relative w-full group cursor-pointer overflow-hidden shadow-elegant border-2 border-transparent hover:border-brand-500">
    <a href={href} class="block">
      <div class="relative">
        <Cover
          engine={coverEngine}
          image={image}
          title={title}
          variant="featured"
          loading="eager"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-neutral-900/85 via-neutral-900/35 to-transparent group-hover:from-neutral-900/75 group-hover:via-neutral-900/25 pointer-events-none"></div>

        {/* Featured + status badges */}
        <div class="absolute top-4 left-4 sm:top-6 sm:left-6 flex items-center gap-1.5 bg-brand-600 text-neutral-0 px-3 py-1.5 sm:px-4 sm:py-2 text-xs sm:text-sm font-semibold shadow-lg">
          <StarIcon className="w-4 h-4" weight="fill" />
          Featured
        </div>
        {project && (
          <div class={`absolute top-4 right-4 sm:top-6 sm:right-6 px-3 py-1.5 sm:px-4 sm:py-2 text-xs sm:text-sm font-semibold border shadow-lg ${statusClass[project.status]}`}>
            {statusText[project.status]}
          </div>
        )}

        <div class="absolute inset-0 flex flex-col justify-end p-5 sm:p-8 lg:p-10 text-neutral-0 pointer-events-none">
          <div class="max-w-4xl">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 mb-4 text-xs font-medium bg-white/20 backdrop-blur-sm">
              <KindIcon className="w-4 h-4" />
              {kindLabel}
            </span>

            <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold mb-3 sm:mb-4 leading-tight group-hover:text-brand-300">
              {title}
            </h2>

            <div class="flex flex-wrap items-center gap-x-4 gap-y-2 mb-4 sm:mb-5 text-neutral-200 text-sm">
              <time class="flex items-center gap-1.5">
                <CalendarIcon className="w-4 h-4" />
                {formatDate(date)}
              </time>
              {readTime && (
                <span class="flex items-center gap-1.5">
                  <ClockIcon className="w-4 h-4" />
                  {readTime}
                </span>
              )}
              {project?.overview?.academic?.institution && (
                <span class="hidden sm:inline">{project.overview.academic.institution}</span>
              )}
            </div>

            {project?.description && (
              <p class="hidden sm:block text-base lg:text-lg text-neutral-100 mb-5 leading-relaxed max-w-3xl line-clamp-2">
                {project.description}
              </p>
            )}

            <div class="flex flex-wrap gap-2 mb-5">
              {tags.slice(0, 4).map((tag) => (
                <span class="px-3 py-1 bg-white/20 backdrop-blur-sm text-sm font-medium">
                  {getTagLabel(tag)}
                </span>
              ))}
              {tags.length > 4 && (
                <span class="px-3 py-1 bg-white/20 backdrop-blur-sm text-sm font-medium">
                  +{tags.length - 4} more
                </span>
              )}
            </div>

            <div class="flex items-center text-sm sm:text-base font-semibold group-hover:text-brand-300">
              <span>{ctaLabel}</span>
              <ArrowRightIcon className="w-5 h-5 ml-2" />
            </div>
          </div>
        </div>
      </div>
    </a>
  </article>
) : (
  <article class="group bg-card-gradient overflow-hidden shadow-elegant border border-neutral-200/50  hover:bg-neutral-0 hover:border-brand-300/60 cursor-pointer     h-full flex flex-col">
    <a href={href} class="block flex-1 flex flex-col">
      <div class="relative overflow-hidden">
        <div class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-neutral-900/20 z-10 pointer-events-none"></div>
        <Cover engine={coverEngine} image={image} title={title} loading="lazy" />

        {readTime && (
          <div class="absolute top-4 right-4 bg-neutral-0/95 backdrop-blur-md px-3 py-1.5 text-xs font-semibold text-neutral-700 border border-neutral-200/50 shadow-sm z-20 flex items-center gap-1.5">
            <ClockIcon className="w-3.5 h-3.5" />
            {readTime}
          </div>
        )}

        {project && (
          <div class={`absolute top-4 right-4 px-3 py-1.5 text-xs font-semibold border shadow-sm z-20 ${statusClass[project.status]}`}>
            {statusText[project.status]}
          </div>
        )}
      </div>

      <div class="p-6 sm:p-8 flex-1 flex flex-col">
        <h2 class="text-xl sm:text-2xl font-bold text-neutral-900 mb-3 line-clamp-2 group-hover:text-brand-700   leading-tight">
          {title}
        </h2>

        <div class="flex items-center gap-1.5 text-sm text-neutral-500 mb-4">
          <CalendarIcon className="w-4 h-4" />
          <time>{formatDate(date)}</time>
        </div>

        {project?.description && (
          <p class="text-neutral-600 text-sm mb-4 line-clamp-3">
            {project.description}
          </p>
        )}

        {project?.links?.code && (
          <div class="flex gap-3 mb-4 text-sm">
            <a href={project.links.code} target="_blank" rel="noopener noreferrer" class="text-neutral-600 hover:text-neutral-800 font-medium flex items-center gap-1" onclick="event.stopPropagation()">
              <GithubIcon className="w-3.5 h-3.5" />
              Code
            </a>
          </div>
        )}

        <div class="mb-4">
          <Tags tags={tags} />
        </div>

        <div class="flex-1"></div>

        <div class="flex items-center text-neutral-900 text-sm font-medium pt-3 border-t border-neutral-100 group-hover:text-brand-700   mt-auto">
          <span>{ctaLabel}</span>
          <ArrowRightIcon className="w-4 h-4 ml-1.5   " />
        </div>
      </div>
    </a>
  </article>
)}
