<script is:inline>
  (function() {
    // Only run in browser
    if (typeof window === 'undefined') return;

    // Generate or retrieve unique visitor ID
    const getVisitorId = () => {
      try {
        let visitorId = localStorage.getItem('visitor_id');
        if (!visitorId) {
          // Generate a simple unique ID
          visitorId = 'v_' + Date.now() + '_' + Math.random().toString(36).slice(2, 11);
          localStorage.setItem('visitor_id', visitorId);
        }
        return visitorId;
      } catch (e) {
        // Fallback if localStorage is not available
        return 'session_' + Date.now() + '_' + Math.random().toString(36).slice(2, 11);
      }
    };

    // Track session ID (changes per browser session)
    const getSessionId = () => {
      try {
        let sessionId = sessionStorage.getItem('session_id');
        if (!sessionId) {
          sessionId = 's_' + Date.now() + '_' + Math.random().toString(36).slice(2, 11);
          sessionStorage.setItem('session_id', sessionId);
        }
        return sessionId;
      } catch (e) {
        return null;
      }
    };

    const sendAnalytics = async () => {
      try {
        const data = {
          visitorId: getVisitorId(),
          sessionId: getSessionId(),
          path: window.location.pathname,
          referrer: document.referrer,
          userAgent: navigator.userAgent,
          screenWidth: window.screen.width,
          screenHeight: window.screen.height,
          // Additional analytics data
          viewportWidth: window.innerWidth,
          viewportHeight: window.innerHeight,
          devicePixelRatio: window.devicePixelRatio || 1,
          language: navigator.language || navigator.userLanguage,
          timezone: Intl.DateTimeFormat().resolvedOptions().timeZone,
          colorScheme: window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light',
          // Connection info (if available)
          connectionType: navigator.connection?.effectiveType || 'unknown',
          // Touch capability
          touchEnabled: 'ontouchstart' in window || navigator.maxTouchPoints > 0,
          // Page performance (in milliseconds) - use modern Performance API
          loadTime: (() => {
            try {
              // Use modern Performance API
              const perfEntries = performance.getEntriesByType('navigation');
              if (perfEntries && perfEntries.length > 0) {
                const navTiming = perfEntries[0];
                return Math.round(navTiming.loadEventEnd - navTiming.fetchStart);
              }
              // Fallback to deprecated API if available and valid
              if (performance.timing && performance.timing.loadEventEnd > 0) {
                return performance.timing.loadEventEnd - performance.timing.navigationStart;
              }
              return null;
            } catch (e) {
              return null;
            }
          })(),
        };

        const response = await fetch('/api/analytics', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(data),
        });

        if (!response.ok) {
          console.warn('Analytics request failed with status:', response.status);
        }
      } catch (error) {
        // Silently fail - don't block page load
        console.warn('Analytics not available:', error instanceof Error ? error.message : 'Unknown error');
      }
    };

    // Wait for page to fully load before sending analytics
    if (document.readyState === 'complete') {
      // Page already loaded
      setTimeout(() => sendAnalytics().catch(() => {}), 100);
    } else {
      // Wait for load event
      window.addEventListener('load', () => {
        setTimeout(() => sendAnalytics().catch(() => {}), 100);
      });
    }

    // Support for View Transitions
    document.addEventListener('astro:page-load', () => {
      setTimeout(() => {
        sendAnalytics().catch(() => {});
      }, 100);
    });
  })();
</script>
