---
/**
 * AppUpdateCard, the compact "this app is still being worked on" card.
 *
 * Shows one app's newest release as a teaser and links to its full history
 * on /updates. Used on the home page and at the top of /updates.
 */
import { Card, Chip } from "../common";
import { ArrowRightIcon } from "@phosphor-icons/react";
import { appAnchor, displayVersion, formatReleaseDate } from "@/data/patch-notes";
import type { AppUpdates } from "@/data/patch-notes";

interface Props {
  updates: AppUpdates;
  class?: string;
}

const { updates, class: extraClass = "" } = Astro.props;
const { app, latest } = updates;

// The teaser: the release's first couple of notes, however they are grouped.
const teaser = latest.changes.flatMap((group) => group.items).slice(0, 2);
const href = `/updates#${appAnchor(app.name)}`;
---

<Card href={href} hoverable padding="md" class={extraClass}>
  <div class="flex items-center gap-3">
    <img src={app.logoPath} alt="" class="w-10 h-10 shrink-0" width="40" height="40" />
    <div class="min-w-0">
      <h3 class="text-lg font-bold text-neutral-900">{app.name}</h3>
      <p class="text-xs text-neutral-500">{app.tagline}</p>
    </div>
  </div>

  <div class="mt-4 flex flex-wrap items-center gap-2">
    <Chip variant="brand" size="xs">{displayVersion(latest.version)}</Chip>
    <time datetime={latest.date} class="text-sm text-neutral-500">
      {formatReleaseDate(latest)}
    </time>
  </div>

  {latest.title && (
    <p class="mt-2 text-base font-semibold text-neutral-800">{latest.title}</p>
  )}

  {teaser.length > 0 && (
    <ul class="mt-3 space-y-2">
      {teaser.map((item) => (
        <li class="flex gap-2.5 text-sm text-neutral-600 leading-relaxed">
          <span class="mt-2 w-1.5 h-1.5 bg-brand-500 shrink-0" />
          <span class="line-clamp-2">{item}</span>
        </li>
      ))}
    </ul>
  )}

  <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-600 group-hover:text-brand-700">
    See all updates
    <ArrowRightIcon className="w-4 h-4" />
  </span>
</Card>
