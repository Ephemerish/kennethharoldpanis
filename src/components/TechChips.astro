---
/**
 * TechChips — the one way tech is shown across the site.
 *
 * Renders a list of tech names (validated against src/data/technologies.ts)
 * as logo chips that link to their /tech/{slug} page. Missing logos fall back
 * to a small dot, so an unregistered-logo tech still looks intentional.
 */
import { getTechByName, techSlug } from "../data/technologies";

interface Props {
  tech: string[];
  /** "sm" for compact card rows, "md" (default) for detail pages. */
  size?: "sm" | "md";
}

const { tech, size = "md" } = Astro.props;

const items = tech.map((name) => {
  const match = getTechByName(name);
  const label = match?.name ?? name;
  return { label, slug: techSlug(label), imagePath: match?.imagePath };
});

const logo = size === "sm" ? "w-4 h-4" : "w-5 h-5";
const text = size === "sm" ? "text-xs" : "text-sm";
const pad = size === "sm" ? "py-1 pl-1.5 pr-2.5 gap-1.5" : "py-1.5 pl-2 pr-3 gap-2";
---

<div class="flex flex-wrap gap-2">
  {items.map((item) => (
    <a
      href={`/tech/${item.slug}`}
      class:list={[
        "inline-flex items-center bg-neutral-50 border border-neutral-200 hover:border-brand-300 hover:bg-brand-50",
        pad,
      ]}
    >
      {item.imagePath ? (
        <img src={item.imagePath} alt={item.label} class:list={[logo, "object-contain"]} loading="lazy" />
      ) : (
        <span class="w-1.5 h-1.5 bg-brand-400"></span>
      )}
      <span class:list={[text, "text-neutral-700"]}>{item.label}</span>
    </a>
  ))}
</div>
