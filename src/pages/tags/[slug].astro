---
import TagPage from "@app/pages/tags/[slug]/TagPage.astro";
import { loadTaxonomy } from "@app/features/taxonomy/collect";

export const prerender = true;

// One page per tag that anything on the site carries.
export async function getStaticPaths() {
  const taxonomy = await loadTaxonomy();
  return [...taxonomy.tagSlugs].map((slug) => ({ params: { slug }, props: { slug, ...taxonomy.withTag(slug) } }));
}

const { slug, entries, bio } = Astro.props;
---

<TagPage slug={slug} entries={entries} bio={bio} />
