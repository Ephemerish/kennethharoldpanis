---
export const prerender = true;
import MainLayout from "../../layouts/MainLayout.astro";
import PageSection from "../../components/PageSection.astro";
import PageHeader from "../../components/PageHeader.astro";
import { getCollection } from "astro:content";
import { getTagsByGroup, type TagGroup } from "../../data/tags";

const [projects, blogs] = await Promise.all([
  getCollection("projects"),
  getCollection("blog"),
]);

// How many entries use each tag, so we only list tags that are in use.
const counts = new Map<string, number>();
for (const entry of [...projects, ...blogs])
  for (const tag of entry.data.tags)
    counts.set(tag, (counts.get(tag) ?? 0) + 1);

const groups: { key: TagGroup; title: string }[] = [
  { key: "domain", title: "Domain" },
  { key: "type", title: "Type" },
  { key: "topic", title: "Topic" },
];

const sections = groups
  .map((group) => ({
    ...group,
    tags: getTagsByGroup(group.key).filter((tag) => counts.has(tag.slug)),
  }))
  .filter((section) => section.tags.length > 0);
---

<MainLayout
  title="Tags - Kenneth Harold Panis"
  description="Browse projects and posts by tag."
>
  <PageSection variant="hero">
    <PageHeader
      prefix="Browse by"
      accent="Tag"
      subtitle="Find projects and posts grouped by what they're about."
      glow
    />

    <div class="space-y-10 sm:space-y-12 max-w-4xl mx-auto">
      {sections.map((section) => (
        <section>
          <h2 class="text-[11px] font-semibold uppercase tracking-wider text-neutral-400 mb-4">
            {section.title}
          </h2>
          <div class="flex flex-wrap gap-2.5">
            {section.tags.map((tag) => (
              <a
                href={`/tags/${tag.slug}`}
                class="inline-flex items-center gap-2 px-3 py-1.5 bg-neutral-100 text-neutral-900 text-sm font-medium border border-neutral-200 hover:border-brand-300 hover:bg-brand-50"
              >
                <span class="w-1.5 h-1.5 bg-brand-500"></span>
                {tag.label}
                <span class="text-xs text-neutral-500">{counts.get(tag.slug)}</span>
              </a>
            ))}
          </div>
        </section>
      ))}
    </div>
  </PageSection>
</MainLayout>
