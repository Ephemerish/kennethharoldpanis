---
export const prerender = true;
import MainLayout from "../../layouts/MainLayout.astro";
import Pagination from "../../components/Pagination.astro";
import PageSection from "../../components/PageSection.astro";
import PageHeader from "../../components/PageHeader.astro";
import BlogsGrid from "./_components/BlogsGrid.astro";
import EmptyBlogsState from "./_components/EmptyBlogsState.astro";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { BLOGS_PER_PAGE } from "../../constants";

const currentPage: number = +Astro.url.searchParams.get("page")! || 1;

const allBlogs: CollectionEntry<"blog">[] = (
  await getCollection("blog")
).sort(
  (a: CollectionEntry<"blog">, b: CollectionEntry<"blog">) =>
    b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const totalPages: number = Math.ceil(allBlogs.length / BLOGS_PER_PAGE);

const blogsForPage: CollectionEntry<"blog">[] = allBlogs.slice(
  (currentPage - 1) * BLOGS_PER_PAGE,
  currentPage * BLOGS_PER_PAGE
);
---

<MainLayout
  title="Blog - Kenneth Harold Panis"
  description="Read my thoughts on technology, development, IoT projects, and engineering insights. Sharing knowledge and experiences from my journey as a developer."
  image="/images/me/me.jpg"
  type="website"
>
  <PageSection variant="hero">
    <PageHeader
      prefix="My"
      accent="Blogs"
      subtitle="Thoughts, tutorials, and insights from my journey in technology and development."
    />

    {allBlogs.length === 0 ? (
      <EmptyBlogsState />
    ) : (
      <BlogsGrid blogs={blogsForPage} />
    )}

    {totalPages > 1 && (
      <div class="mt-12 sm:mt-16">
        <Pagination
          currentPage={currentPage}
          totalPages={totalPages}
          disablePrevious={currentPage === 1}
          disableNext={currentPage === totalPages}
        />
      </div>
    )}
  </PageSection>
</MainLayout>
