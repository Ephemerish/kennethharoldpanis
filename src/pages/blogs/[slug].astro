---
import MainLayout from "../../layouts/MainLayout.astro";
import ProseArticle from "../../components/articles/ProseArticle.astro";
import PretextArticle from "../../components/articles/PretextArticle.astro";
import { getCollection } from "astro:content";
import { ArrowLeftIcon } from "@phosphor-icons/react";
import { DEFAULT_ENGINE, type EngineKey } from "../../lib/engines";

export const prerender = true;

export async function getStaticPaths() {
  const blogEntries = await getCollection("blog");
  return blogEntries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const rendered = entry ? await entry.render() : null;
const Content = rendered?.Content;

// Engine registry -> component. Each blog entry declares an `engine` in its
// frontmatter (defaulting to the markdown renderer). Add a new engine by
// registering it in src/lib/engines and mapping its key here.
const ENGINE_COMPONENTS: Record<EngineKey, any> = {
  prose: ProseArticle,
  pretext: PretextArticle,
};
const engineKey = (entry?.data.engine ?? DEFAULT_ENGINE) as EngineKey;
const ArticleEngine = ENGINE_COMPONENTS[engineKey] ?? ProseArticle;
---

{entry && Content ? (
  <ArticleEngine entry={entry} Content={Content} />
) : (
  <MainLayout title="Blog Post">
    <section class="bg-white text-neutral-900 relative overflow-hidden">
      <div class="absolute inset-0">
        <div class="max-w-7xl mx-auto h-full px-4 sm:px-6 lg:px-8">
          <div class="bg-neutral-0 border-l border-r border-neutral-200 h-full"></div>
        </div>
      </div>
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 relative">
        <div class="px-4 sm:px-6 lg:px-8 text-center">
          <h2 class="text-2xl font-bold text-gray-900 mb-4">Article not found</h2>
          <p class="text-gray-600 mb-8">The blog post you are looking for does not exist.</p>
          <a
            href="/blogs"
            class="inline-flex items-center gap-2 px-6 py-3 bg-black text-white hover:bg-gray-800 "
          >
            <ArrowLeftIcon className="w-4 h-4" />
            Back to all posts
          </a>
        </div>
      </div>
    </section>
  </MainLayout>
)}
