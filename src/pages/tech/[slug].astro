---
import TechPage from "@app/pages/tech/[slug]/TechPage.astro";
import { loadTaxonomy } from "@app/features/taxonomy/collect";

export const prerender = true;

// One page per technology that anything on the site uses.
export async function getStaticPaths() {
  const taxonomy = await loadTaxonomy();
  return [...taxonomy.techSlugs].map((slug) => ({ params: { slug }, props: { slug, ...taxonomy.withTech(slug) } }));
}

const { slug, entries, bio } = Astro.props;
---

<TechPage slug={slug} entries={entries} bio={bio} />
