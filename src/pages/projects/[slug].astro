        <a 
          href="/projects" 
          class="inline-flex items-center gap-2 text-black hover:text-gray-700 font-medium transition-colors"
        >
          <ArrowLeftIcon className="w-4 h-4" />
          Back to all projects
        </a>
        <div class="flex flex-wrap gap-4">
          <a 
            href="/contact" 
            class="inline-block px-4 py-2 bg-black text-white rounded-lg hover:bg-gray-800 transition-colors font-medium text-sm"
          >
            Discuss This Project
          </a>
        </div>
      </div>
    </footer>
    </article>
      </div>
    </div>
