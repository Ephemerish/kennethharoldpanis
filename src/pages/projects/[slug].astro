---
import { getCollection } from "astro:content";
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import type { CollectionEntry } from "astro:content";
import Gallery from "../../components/Gallery.tsx";
import ProjectDetails from "../../components/ProjectDetails.astro";
import { ArrowSquareOutIcon as ArrowTopRightOnSquareIcon } from "@phosphor-icons/react";

export const prerender = true;

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props as { project: CollectionEntry<"projects"> };
const { Content } = await project.render();
const d = project.data;

const statusText = {
  completed: "Completed",
  "in-progress": "In Progress",
  planned: "Planned",
};

const statusColors = {
  completed: "bg-success-200 text-success-800",
  "in-progress": "bg-warning-200 text-warning-800",
  planned: "bg-neutral-200 text-neutral-600",
};

// Header carries only the status pill; the date comes from ArticleLayout.
const badges = [{ label: statusText[d.status], class: statusColors[d.status] }];

const galleryImages = (d.gallery ?? []).map((img) => `/images/${img}`);
---

<ArticleLayout
  title={d.title}
  description={d.description}
  heroImage={d.image}
  date={d.startDate}
  badges={badges}
>
  {d.links?.live && (
    <a
      slot="actions"
      href={d.links.live}
      target="_blank"
      rel="noopener noreferrer"
      class="group/live bg-brand-gradient text-neutral-0 px-6 py-3     font-semibold flex w-full justify-center items-center gap-2.5"
    >
      <span class="relative flex h-2.5 w-2.5" aria-hidden="true">
        <span class="absolute inline-flex h-full w-full bg-neutral-0 opacity-75 "></span>
        <span class="relative inline-flex h-2.5 w-2.5 bg-neutral-0"></span>
      </span>
      Visit Live Site
      <ArrowTopRightOnSquareIcon className="w-4 h-4 opacity-80   group-hover/live:translate-x-0.5 group-hover/live:-translate-y-0.5" />
    </a>
  )}
  {d.links?.code && (
    <a
      slot="actions"
      href={d.links.code}
      target="_blank"
      rel="noopener noreferrer"
      class="border border-brand-300 text-brand-700 px-6 py-3 hover:bg-brand-50  font-medium inline-flex items-center"
    >
      <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 24 24">
        <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
      </svg>
      View Code
    </a>
  )}

  {/* Lead: gallery + a single calm overview panel, before the story */}
  <div slot="lead" class="space-y-8">
    {galleryImages.length > 0 && (
      <Gallery client:visible images={galleryImages} alt={d.title} />
    )}
    <ProjectDetails data={d} />
  </div>

  <Content />
</ArticleLayout>
