---
import { ArrowSquareOutIcon as ArrowTopRightOnSquareIcon } from "@phosphor-icons/react";
import { GitHubIcon } from "@/components";

interface Props {
  links?: { live?: string; code?: string };
}

const { links } = Astro.props;
---

{links?.live && (
  <a
    href={links.live}
    target="_blank"
    rel="noopener noreferrer"
    class="group/live bg-brand-gradient text-neutral-0 px-6 py-3     font-semibold flex w-full justify-center items-center gap-2.5"
  >
    <span class="relative flex h-2.5 w-2.5" aria-hidden="true">
      <span class="absolute inline-flex h-full w-full bg-neutral-0 opacity-75 "></span>
      <span class="relative inline-flex h-2.5 w-2.5 bg-neutral-0"></span>
    </span>
    Visit Live Site
    <ArrowTopRightOnSquareIcon className="w-4 h-4 opacity-80   group-hover/live:translate-x-0.5 group-hover/live:-translate-y-0.5" />
  </a>
)}
{links?.code && (
  <a
    href={links.code}
    target="_blank"
    rel="noopener noreferrer"
    class="border border-brand-300 text-brand-700 px-6 py-3 hover:bg-brand-50  font-medium inline-flex items-center"
  >
    <GitHubIcon class="w-4 h-4 mr-2" />
    View Code
  </a>
)}
