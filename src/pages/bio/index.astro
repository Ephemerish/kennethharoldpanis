---
export const prerender = true;
import Layout from "../../layouts/MainLayout.astro";
import BioSubnav from "../../components/BioSubnav.astro";
import PageSection from "../../components/PageSection.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import Card from "../../components/Card.astro";
import IconBadge from "../../components/IconBadge.astro";
import StatusPill from "../../components/StatusPill.astro";
import Chip from "../../components/Chip.astro";
import TechChips from "../../components/TechChips.astro";
import {
  ArrowRightIcon,
  ArrowSquareOutIcon as ArrowTopRightOnSquareIcon,
  StarIcon,
} from "@phosphor-icons/react";
import { timeline } from "../../data/experience";
import { certifications } from "../../data/certifications";
---

<Layout
  title="Bio - Kenneth Harold Panis"
  description="About Kenneth Harold Panis, software developer growing his cloud and software development skills, with certifications across FinOps and Google Cloud, and ongoing AWS learning."
  image="/images/me/me.jpg"
  type="profile"
>
  <PageSection variant="hero">
    <section class="mb-16 sm:mb-20">
      <SectionHeader
        prefix="My"
        accent="Experience"
        subtitle="Roles, education, and project work, most recent first."
      />

      <div class="flex flex-col">
        {timeline.map((entry, i) => {
          const isCurrent = entry.end.toLowerCase() === "current";
          const isLast = i === timeline.length - 1;
          const dateLabel = isCurrent ? `${entry.start} – Current` : `${entry.start} – ${entry.end}`;
          return (
            <div class="flex gap-4 sm:gap-6">
              <div class="flex flex-col items-center w-3.5 shrink-0">
                <span
                  class:list={[
                    "w-3.5 h-3.5 shrink-0 ring-[5px] ring-white",
                    isCurrent ? "bg-brand-600" : "bg-neutral-400",
                  ]}
                  aria-hidden="true"
                />
                {!isLast && <div class="w-0.5 flex-1 bg-neutral-200" aria-hidden="true" />}
              </div>
              <div class:list={["flex-1 min-w-0", !isLast && "pb-6 sm:pb-8"]}>
                <Card padding="none" class="overflow-hidden">
                  <div
                    class:list={[
                      "flex flex-wrap items-center justify-between gap-x-3 gap-y-2 px-6 sm:px-8 py-4 sm:py-5",
                      isCurrent ? "bg-brand-gradient" : "bg-neutral-900",
                    ]}
                  >
                    <div class="flex items-center gap-3 text-neutral-0 min-w-0">
                      <span class="flex items-center justify-center w-8 h-8 sm:w-9 sm:h-9 bg-white/10 border border-white/20 shrink-0">
                        <entry.Icon className="w-4 h-4 sm:w-4.5 sm:h-4.5" weight="bold" />
                      </span>
                      <span class="font-mono text-sm sm:text-base tracking-tight">{dateLabel}</span>
                    </div>
                    {isCurrent && (
                      <span class="inline-flex items-center gap-1.5 text-[11px] sm:text-xs font-semibold uppercase tracking-wider text-neutral-0 bg-white/15 border border-white/25 px-2.5 py-1.5 shrink-0">
                        <span class="w-1.5 h-1.5 bg-neutral-0" aria-hidden="true" />
                        Current
                      </span>
                    )}
                  </div>
                  <div class="px-6 sm:px-8 py-6 sm:py-8">
                    <h3 class="text-xl sm:text-2xl font-bold text-neutral-900 mb-1 tracking-tight">{entry.title}</h3>
                    <p class="text-sm sm:text-base text-neutral-600 font-medium mb-4">{entry.org}</p>
                    <p class="text-sm sm:text-base text-neutral-700 leading-relaxed">
                      {entry.body}
                    </p>
                    {entry.tech && (
                      <div class="mt-5">
                        <TechChips tech={entry.tech} size="sm" />
                      </div>
                    )}
                    {entry.href && (
                      <div class="mt-5 pt-5 border-t border-neutral-100">
                        <a
                          href={entry.href}
                          class="inline-flex items-center text-sm font-semibold text-brand-700 hover:text-brand-800"
                        >
                          <span>{entry.ctaLabel}</span>
                          <ArrowRightIcon className="w-4 h-4 ml-1.5" />
                        </a>
                      </div>
                    )}
                  </div>
                </Card>
              </div>
            </div>
          );
        })}
      </div>
    </section>

    <section class="mb-16 sm:mb-20">
      <SectionHeader
        prefix="My"
        accent="Certifications"
        subtitle="Markers of where I've been learning, across software development and cloud. Currently shipping projects on Google Cloud, learning AWS, and using my FinOps cert as a financial lens on how I architect."
      />

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 sm:gap-10">
        {certifications.filter((cert) => !cert.status).map((cert) => (
          <Card
            padding="none"
            class="relative flex flex-col overflow-hidden"
            hoverable={!!cert.credentialUrl}
            href={cert.credentialUrl}
            target={cert.credentialUrl ? "_blank" : undefined}
            rel={cert.credentialUrl ? "noopener noreferrer" : undefined}
          >
            {cert.highlighted && (
              <div class="absolute top-4 right-4 z-10">
                <StatusPill variant="brand" Icon={StarIcon}>Featured</StatusPill>
              </div>
            )}

            <div class="relative px-6 sm:px-8 pt-8 sm:pt-10 pb-4 flex items-center justify-center">
              <div class:list={[
                "absolute inset-0 blur-2xl",
                cert.accent === "brand" ? "bg-brand-100/40" : "bg-neutral-100/40",
              ]} />
              {cert.badge ? (
                <img
                  src={`/images/${cert.badge}`}
                  alt={`${cert.title} badge`}
                  class="relative w-32 h-32 sm:w-40 sm:h-40 object-contain"
                  loading="lazy"
                />
              ) : (
                <IconBadge Icon={cert.Icon} variant={cert.accent} size="xl" class="relative shadow-lg" />
              )}
            </div>

            <div class="px-6 sm:px-8 pb-6 sm:pb-8 flex-1 flex flex-col">
              <div class="text-center mb-5">
                <h3 class="text-xl sm:text-2xl font-bold text-neutral-900 mb-2 leading-tight group-hover:text-brand-700">
                  {cert.title}
                </h3>
                <p class="text-sm sm:text-base text-neutral-600 font-medium">
                  {cert.issuer}
                  {cert.issuedDate && (
                    <span class="text-neutral-400"> · {cert.issuedDate}</span>
                  )}
                </p>
              </div>

              <p class="text-sm sm:text-base text-neutral-700 mb-5 leading-relaxed">
                {cert.summary}
              </p>

              <div class="mb-5">
                <p class="text-xs font-semibold uppercase tracking-wider text-neutral-500 mb-3">
                  Focus areas
                </p>
                <div class="flex flex-wrap gap-2">
                  {cert.focusAreas.map((area) => (
                    <Chip variant={cert.chipVariant}>{area}</Chip>
                  ))}
                </div>
              </div>

              {cert.tech && (
                <div class="mb-5">
                  <p class="text-xs font-semibold uppercase tracking-wider text-neutral-500 mb-3">
                    Tech I've used it with
                  </p>
                  <TechChips tech={cert.tech} size="sm" linked={!cert.credentialUrl} />
                </div>
              )}

              <div class="flex-1" />

              {cert.credentialUrl && (
                <div class="flex items-center justify-center gap-1.5 mt-4 pt-4 border-t border-neutral-100 text-sm font-semibold text-brand-700 group-hover:text-brand-800">
                  <span>Verify credential</span>
                  <ArrowTopRightOnSquareIcon className="w-4 h-4" />
                </div>
              )}
            </div>
          </Card>
        ))}
      </div>

      {certifications.filter((cert) => cert.status).map((cert) => (
        <Card padding="lg" class="mt-8 sm:mt-10">
          <div class="flex flex-col sm:flex-row items-start sm:items-center gap-6">
            <IconBadge Icon={cert.Icon} variant={cert.accent} size="lg" class="shrink-0" />
            <div class="flex-1">
              <StatusPill variant={cert.status!.variant} Icon={cert.status!.Icon} class="mb-3">
                {cert.status!.label}
              </StatusPill>
              <h3 class="text-xl sm:text-2xl font-bold text-neutral-900 mb-2">{cert.title}</h3>
              <p class="text-sm sm:text-base text-neutral-700 leading-relaxed mb-4">
                {cert.summary}
              </p>
              <div class="flex flex-wrap gap-2">
                {cert.focusAreas.map((area) => (
                  <Chip variant={cert.chipVariant}>{area}</Chip>
                ))}
              </div>
            </div>
          </div>
        </Card>
      ))}
    </section>

    <BioSubnav current="about" />
  </PageSection>
</Layout>
