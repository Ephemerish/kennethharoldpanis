---
export const prerender = true;
import Layout from "../../layouts/MainLayout.astro";
import BioSubnav from "../../components/BioSubnav.astro";
import PageSection from "../../components/PageSection.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import Card from "../../components/Card.astro";
import IconBadge from "../../components/IconBadge.astro";
import StatusPill from "../../components/StatusPill.astro";
import Chip from "../../components/Chip.astro";
import TechChips from "../../components/TechChips.astro";
import {
  ArrowRightIcon,
  ArrowSquareOutIcon as ArrowTopRightOnSquareIcon,
  FileTextIcon,
  CloudIcon,
  ChartLineUpIcon,
  StarIcon,
  HourglassIcon,
  CheckCircleIcon,
  BookOpenIcon,
} from "@phosphor-icons/react";
import { timeline } from "../../data/experience";
import { certifications } from "../../data/certifications";

const cloudJourney = [
  {
    title: "Google Cloud Platform",
    role: "My primary cloud",
    body: "Day-to-day I deploy, monitor, and operate projects on GCP, backed by my Associate Cloud Engineer certification.",
    chips: ["Compute Engine", "Cloud Run", "Cloud Storage", "IAM", "Cloud SQL"],
    Icon: CloudIcon,
    iconVariant: "brand" as const,
    chipVariant: "brand" as const,
    statusVariant: "success" as const,
    statusIcon: CheckCircleIcon,
    statusLabel: "Active",
  },
  {
    title: "AWS Solutions Architect",
    role: "Learning & certifying, ongoing",
    body: "Actively learning AWS and integrating it into my workflow, working toward the Solutions Architect certification to extend my cloud range beyond GCP.",
    chips: ["EC2", "S3", "VPC", "Lambda", "RDS", "Well-Architected"],
    Icon: BookOpenIcon,
    iconVariant: "dark" as const,
    chipVariant: "neutral" as const,
    statusVariant: "warning" as const,
    statusIcon: HourglassIcon,
    statusLabel: "In progress",
  },
];
---

<Layout
  title="Bio - Kenneth Harold Panis"
  description="About Kenneth Harold Panis, software developer growing his cloud and software development skills, with certifications across FinOps and Google Cloud, and ongoing AWS learning."
  image="/images/me/me.jpg"
  type="profile"
>
  <PageSection variant="hero">
    <section class="mb-16 sm:mb-20">
      <SectionHeader
        prefix="My"
        accent="Experience"
        subtitle="Roles, education, and project work, a timeline of how I got here."
      />

      <div class="relative">
        <div
          class="absolute top-2 bottom-2 left-[5rem] sm:left-[9rem] w-px bg-neutral-200"
          aria-hidden="true"
        />
        <div class="flex flex-col gap-10 sm:gap-12">
          {timeline.map((entry) => (
            <div class="relative grid grid-cols-[4.5rem_1fr] sm:grid-cols-[8rem_1fr] gap-x-4 sm:gap-x-8">
              <div class="text-right pt-1">
                <p class="text-xl sm:text-3xl font-bold text-neutral-900 leading-none">{entry.start}</p>
                <p class="mt-1.5 text-[11px] sm:text-xs font-semibold uppercase tracking-wider text-neutral-400">
                  {entry.end}
                </p>
              </div>
              <div class="relative">
                <span
                  class="absolute left-[-0.5rem] sm:left-[-1rem] top-3 -translate-x-1/2 w-3.5 h-3.5 rounded-full bg-brand-600 ring-4 ring-white z-10"
                  aria-hidden="true"
                />
                <Card padding="lg" hoverable={!!entry.href} href={entry.href}>
                  <div class="flex flex-col sm:flex-row gap-4 sm:gap-6">
                    <IconBadge Icon={entry.Icon} variant="brand" size="md" class="shrink-0" />
                    <div class="flex-1">
                      <h3 class="text-lg sm:text-xl font-bold text-neutral-900 mb-1 group-hover:text-brand-700">{entry.title}</h3>
                      <p class="text-sm sm:text-base text-neutral-600 font-medium mb-3">{entry.org}</p>
                      <p class="text-sm sm:text-base text-neutral-700 leading-relaxed">
                        {entry.body}
                      </p>
                      {entry.tech && (
                        <div class="mt-4">
                          <TechChips tech={entry.tech} size="sm" linked={!entry.href} />
                        </div>
                      )}
                      {entry.href && (
                        <div class="flex items-center text-sm font-semibold text-brand-700 group-hover:text-brand-800 mt-4 pt-4 border-t border-neutral-100">
                          <span>{entry.ctaLabel}</span>
                          <ArrowRightIcon className="w-4 h-4 ml-1.5" />
                        </div>
                      )}
                    </div>
                  </div>
                </Card>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="mb-16 sm:mb-20">
      <SectionHeader
        prefix="My"
        accent="Certifications"
        subtitle="Markers of where I've been learning, across software development and cloud. Currently shipping projects on Google Cloud, learning AWS, and using my FinOps cert as a financial lens on how I architect."
      />

      <Card padding="lg" class="mb-12 sm:mb-16">
        <div class="flex flex-col md:flex-row items-start md:items-center gap-6">
          <IconBadge Icon={ChartLineUpIcon} variant="brand" size="lg" />
          <div class="flex-1">
            <StatusPill variant="brand" Icon={StarIcon} class="mb-3">
              Currently focused on
            </StatusPill>
            <h3 class="text-2xl sm:text-3xl font-bold text-neutral-900 mb-3">
              Growing my <span class="text-brand-gradient">cloud &amp; software dev</span> skills
            </h3>
            <p class="text-base sm:text-lg text-neutral-700 leading-relaxed">
              I'm actively working on my cloud and software development skills,
              building projects on Google Cloud, learning AWS in parallel, and
              using the FinOps cert to think about cost and architecture together.
              These certifications mark where I am on that journey, not a finish line.
            </p>
          </div>
        </div>
      </Card>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 sm:gap-10 mb-16 sm:mb-20">
        {certifications.map((cert) => (
          <Card
            padding="none"
            class="relative flex flex-col overflow-hidden"
            hoverable={!!cert.credentialUrl}
            href={cert.credentialUrl}
            target={cert.credentialUrl ? "_blank" : undefined}
            rel={cert.credentialUrl ? "noopener noreferrer" : undefined}
          >
            {cert.highlighted && (
              <div class="absolute top-4 right-4 z-10">
                <StatusPill variant="brand" Icon={StarIcon}>Featured</StatusPill>
              </div>
            )}

            <div class="relative px-6 sm:px-8 pt-8 sm:pt-10 pb-4 flex items-center justify-center">
              <div class:list={[
                "absolute inset-0 blur-2xl",
                cert.accent === "brand" ? "bg-brand-100/40" : "bg-neutral-100/40",
              ]} />
              {cert.badge ? (
                <img
                  src={`/images/${cert.badge}`}
                  alt={`${cert.title} badge`}
                  class="relative w-32 h-32 sm:w-40 sm:h-40 object-contain"
                  loading="lazy"
                />
              ) : (
                <IconBadge Icon={cert.Icon} variant={cert.accent} size="xl" class="relative shadow-lg" />
              )}
            </div>

            <div class="px-6 sm:px-8 pb-6 sm:pb-8 flex-1 flex flex-col">
              <div class="text-center mb-5">
                <h3 class="text-xl sm:text-2xl font-bold text-neutral-900 mb-2 leading-tight group-hover:text-brand-700">
                  {cert.title}
                </h3>
                <p class="text-sm sm:text-base text-neutral-600 font-medium">
                  {cert.issuer}
                  {cert.issuedDate && (
                    <span class="text-neutral-400"> · {cert.issuedDate}</span>
                  )}
                </p>
              </div>

              <p class="text-sm sm:text-base text-neutral-700 mb-5 leading-relaxed">
                {cert.summary}
              </p>

              <div class="mb-5">
                <p class="text-xs font-semibold uppercase tracking-wider text-neutral-500 mb-3">
                  Focus areas
                </p>
                <div class="flex flex-wrap gap-2">
                  {cert.focusAreas.map((area) => (
                    <Chip variant={cert.chipVariant}>{area}</Chip>
                  ))}
                </div>
              </div>

              {cert.tech && (
                <div class="mb-5">
                  <p class="text-xs font-semibold uppercase tracking-wider text-neutral-500 mb-3">
                    Tech I've used it with
                  </p>
                  <TechChips tech={cert.tech} size="sm" linked={!cert.credentialUrl} />
                </div>
              )}

              <div class="flex-1" />

              {cert.credentialUrl && (
                <div class="flex items-center justify-center gap-1.5 mt-4 pt-4 border-t border-neutral-100 text-sm font-semibold text-brand-700 group-hover:text-brand-800">
                  <span>Verify credential</span>
                  <ArrowTopRightOnSquareIcon className="w-4 h-4" />
                </div>
              )}
            </div>
          </Card>
        ))}
      </div>

      <div>
        <SectionHeader
          prefix="My"
          accent="Cloud Journey"
          subtitle="Currently shipping on Google Cloud while actively learning AWS, building toward multi-cloud fluency."
        />

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8">
          {cloudJourney.map((entry) => (
            <Card padding="none" class="relative flex flex-col overflow-hidden">
              <div class="absolute top-4 right-4 z-10">
                <StatusPill variant={entry.statusVariant} Icon={entry.statusIcon}>
                  {entry.statusLabel}
                </StatusPill>
              </div>

              <div class="relative px-6 sm:px-8 pt-8 sm:pt-10 pb-4 flex items-center justify-center">
                <div class:list={[
                  "absolute inset-0 blur-2xl",
                  entry.iconVariant === "brand" ? "bg-brand-100/40" : "bg-warning-100/40",
                ]} />
                <IconBadge Icon={entry.Icon} variant={entry.iconVariant} size="xl" class="relative shadow-lg" />
              </div>

              <div class="px-6 sm:px-8 pb-6 sm:pb-8 flex-1 flex flex-col text-center">
                <h3 class="text-xl sm:text-2xl font-bold text-neutral-900 mb-2">{entry.title}</h3>
                <p class="text-sm sm:text-base text-neutral-600 font-medium mb-4">{entry.role}</p>
                <p class="text-sm sm:text-base text-neutral-700 leading-relaxed mb-5">{entry.body}</p>
                <div class="flex flex-wrap justify-center gap-2 mt-auto">
                  {entry.chips.map((chip) => (
                    <Chip variant={entry.chipVariant}>{chip}</Chip>
                  ))}
                </div>
              </div>
            </Card>
          ))}
        </div>
      </div>
    </section>

    <div class="mb-16 sm:mb-20">
      <div class="text-center mb-8 sm:mb-10">
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-neutral-900 mb-3">
          More in this section
        </h2>
        <div class="w-24 h-1 bg-brand-gradient mx-auto"></div>
      </div>
      <div class="max-w-md mx-auto">
        <Card hoverable href="/bio/resume" class="flex flex-col">
          <IconBadge Icon={FileTextIcon} variant="brand" size="md" class="mb-4" />
          <h3 class="text-lg sm:text-xl font-bold text-neutral-900 mb-2 group-hover:text-brand-700">
            Resume / CV
          </h3>
          <p class="text-sm sm:text-base text-neutral-600 mb-4 flex-1 leading-relaxed">
            Quick on-page summary and a downloadable PDF.
          </p>
          <div class="flex items-center text-sm font-semibold text-brand-700 group-hover:text-brand-800">
            <span>Visit</span>
            <ArrowRightIcon className="w-4 h-4 ml-1.5" />
          </div>
        </Card>
      </div>
    </div>

    <BioSubnav current="about" />
  </PageSection>
</Layout>
