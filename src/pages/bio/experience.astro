---
export const prerender = true;
import Layout from "../../layouts/MainLayout.astro";
import BioSubnav from "../../components/BioSubnav.astro";
import ButtonLink from "../../components/ButtonLink.astro";
import PageSection from "../../components/PageSection.astro";
import PageHeader from "../../components/PageHeader.astro";
import Card from "../../components/Card.astro";
import IconBadge from "../../components/IconBadge.astro";
import {
  ArrowRightIcon,
  BriefcaseIcon,
  HourglassIcon,
} from "@phosphor-icons/react";
---

<Layout
  title="Experience - Kenneth Harold Panis"
  description="Roles, internships, and project work, a timeline of how I got here."
  image="/images/me/me.jpg"
  type="website"
>
  <PageSection variant="hero">
    <PageHeader
      prefix="My"
      accent="Experience"
      subtitle="Roles, internships, and project work, a timeline of how I got here."
    />

    <div class="max-w-3xl mx-auto mb-16 sm:mb-20">
      <Card padding="lg" class="text-center">
        <div class="flex justify-center mb-6">
          <IconBadge Icon={HourglassIcon} variant="warning" size="lg" />
        </div>
        <h2 class="text-2xl sm:text-3xl font-bold text-neutral-900 mb-4">
          Coming soon
        </h2>
        <p class="text-base sm:text-lg text-neutral-700 leading-relaxed mb-6">
          I'm still putting this page together, a proper timeline of roles
          and project work is on the way. In the meantime, the projects page
          is the best place to see what I've been building.
        </p>
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <ButtonLink href="/projects" variant="gradient" size="lg" class="text-base sm:text-lg font-semibold">
            <BriefcaseIcon className="mr-2 w-5 h-5" />
            See Projects
            <ArrowRightIcon className="ml-3 w-5 h-5" />
          </ButtonLink>
          <ButtonLink href="/bio" variant="outlineBrand" size="lg" class="text-base sm:text-lg font-semibold">
            Back to Bio
          </ButtonLink>
        </div>
      </Card>
    </div>

    <BioSubnav current="experience" />
  </PageSection>
</Layout>
