---
import Layout from "../layouts/MainLayout.astro";
import EntryCard from "../components/EntryCard.astro";
import ButtonLink from "../components/ButtonLink.astro";
import PageSection from "../components/PageSection.astro";
import PageHeader from "../components/PageHeader.astro";
import CtaSection from "../components/CtaSection.astro";
import { ArrowRightIcon } from "@phosphor-icons/react";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";

const allProjects: CollectionEntry<"projects">[] = (
  await getCollection("projects")
).sort((a, b) => {
  if (a.data.featured && !b.data.featured) return -1;
  if (!a.data.featured && b.data.featured) return 1;
  const statusPriority = { completed: 0, "in-progress": 1, planned: 2 };
  const statusDiff = statusPriority[a.data.status] - statusPriority[b.data.status];
  if (statusDiff !== 0) return statusDiff;
  return b.data.startDate.valueOf() - a.data.startDate.valueOf();
});

const featuredProjects = allProjects.filter((project) => project.data.featured);
const regularProjects = allProjects.filter((project) => !project.data.featured);
---

<Layout
  title="Projects - Kenneth Harold Panis"
  description="Explore my portfolio of projects including IoT systems, web applications, mobile apps, and hardware prototypes. From LoRa communication networks to modern web development."
  image="/images/me/me.jpg"
  type="website"
>
  <PageSection variant="hero">
    <PageHeader
      prefix="My"
      accent="Projects"
      subtitle="A collection of things I've built, experiments I've tried, and problems I've solved."
      glow
    />

    {featuredProjects.length > 0 && (
      <section class="mb-16 sm:mb-20">
        <div class="space-y-12 sm:space-y-16">
          {featuredProjects.map((project) => (
            <EntryCard entry={project} kind="project" variant="featured" />
          ))}
        </div>
      </section>
    )}

    {regularProjects.length > 0 && (
      <section class="mb-16 sm:mb-20">
        <div class="grid grid-cols-1 gap-8 sm:gap-10 sm:grid-cols-2 lg:grid-cols-3">
          {regularProjects.map((project) => (
            <EntryCard entry={project} kind="project" />
          ))}
        </div>
      </section>
    )}

    <CtaSection
      prefix="Like what you see?"
      accent="Let's collaborate!"
      subtitle="I'm always interested in working on exciting projects and solving challenging problems."
      size="lg"
    >
      <ButtonLink href="/contact" variant="gradient" size="lg" class="text-lg font-semibold">
        Get In Touch
        <ArrowRightIcon className="ml-3 w-5 h-5" />
      </ButtonLink>
      <ButtonLink
        href="https://github.com/Ephemerish"
        target="_blank"
        rel="noopener noreferrer"
        variant="outlineBrand"
        size="lg"
        class="text-lg font-semibold"
      >
        View GitHub
        <ArrowRightIcon className="ml-3 w-5 h-5" />
      </ButtonLink>
    </CtaSection>
  </PageSection>
</Layout>
