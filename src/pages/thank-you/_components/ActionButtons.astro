---
import { ButtonLink } from "@/components";
import { HouseIcon as HomeIcon, BriefcaseIcon } from "@phosphor-icons/react";
---

<div class="flex flex-col sm:flex-row gap-3 sm:gap-4 justify-center">
  <ButtonLink
    href="/"
    variant="default"
    size="lg"
    class="text-sm sm:text-base shadow-lg  gap-2"
  >
    <HomeIcon className="w-4 h-4 sm:w-5 sm:h-5" />
    Back to Home
  </ButtonLink>

  <ButtonLink
    href="/projects"
    variant="outline"
    size="lg"
    class="text-sm sm:text-base gap-2"
  >
    <BriefcaseIcon className="w-4 h-4 sm:w-5 sm:h-5" />
    View My Work
  </ButtonLink>
</div>
