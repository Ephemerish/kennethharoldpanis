---
import Layout from "../layouts/MainLayout.astro";
import ButtonLink from "../components/ButtonLink.astro";
import { CheckCircleIcon, HouseIcon as HomeIcon, BriefcaseIcon } from "@phosphor-icons/react";
---

<Layout title="Thank You - Kenneth Harold Panis">
  <div class="min-h-screen bg-neutral-0 flex items-center justify-center px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl mx-auto text-center">
      <!-- Success Icon -->
      <div class="w-16 h-16 sm:w-20 sm:h-20 bg-brand-100 flex items-center justify-center mx-auto mb-6 sm:mb-8">
        <CheckCircleIcon className="w-8 h-8 sm:w-10 sm:h-10 text-brand-600" />
      </div>

      <!-- Thank You Message -->
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold text-neutral-900 mb-4 sm:mb-6">
        Thank You!
      </h1>
      
      <p class="text-lg sm:text-xl text-neutral-600 mb-6 sm:mb-8 leading-relaxed px-2">
        Your message has been successfully sent. I appreciate you reaching out and will get back to you as soon as possible, usually within 24 hours.
      </p>

      <!-- What's Next -->
      <div class="bg-neutral-0 shadow-lg p-6 sm:p-8 mb-6 sm:mb-8 border border-neutral-300">
        <h2 class="text-xl sm:text-2xl font-semibold text-neutral-900 mb-3 sm:mb-4">What happens next?</h2>
        <div class="space-y-3 sm:space-y-4 text-left">
          <div class="flex items-start gap-3 sm:gap-4">
            <div class="w-7 h-7 sm:w-8 sm:h-8 bg-neutral-100 flex items-center justify-center shrink-0 mt-1">
              <span class="text-xs sm:text-sm font-bold text-neutral-900">1</span>
            </div>
            <div>
              <h3 class="font-medium text-neutral-900 text-sm sm:text-base">Message Review</h3>
              <p class="text-neutral-600 text-xs sm:text-sm">I'll carefully review your message and any project details you've shared.</p>
            </div>
          </div>
          
          <div class="flex items-start gap-3 sm:gap-4">
            <div class="w-7 h-7 sm:w-8 sm:h-8 bg-neutral-100 flex items-center justify-center shrink-0 mt-1">
              <span class="text-xs sm:text-sm font-bold text-neutral-900">2</span>
            </div>
            <div>
              <h3 class="font-medium text-neutral-900 text-sm sm:text-base">Personal Response</h3>
              <p class="text-neutral-600 text-xs sm:text-sm">You'll receive a personalized response addressing your specific needs and questions.</p>
            </div>
          </div>
          
          <div class="flex items-start gap-3 sm:gap-4">
            <div class="w-7 h-7 sm:w-8 sm:h-8 bg-neutral-100 flex items-center justify-center shrink-0 mt-1">
              <span class="text-xs sm:text-sm font-bold text-neutral-900">3</span>
            </div>
            <div>
              <h3 class="font-medium text-neutral-900 text-sm sm:text-base">Next Steps</h3>
              <p class="text-neutral-600 text-xs sm:text-sm">If it's a good fit, we'll schedule a call to discuss your project in detail.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="flex flex-col sm:flex-row gap-3 sm:gap-4 justify-center">
        <ButtonLink
          href="/"
          variant="default"
          size="lg"
          class="text-sm sm:text-base shadow-lg hover:shadow-xl gap-2"
        >
          <HomeIcon className="w-4 h-4 sm:w-5 sm:h-5" />
          Back to Home
        </ButtonLink>
        
        <ButtonLink
          href="/projects"
          variant="outline"
          size="lg"
          class="text-sm sm:text-base gap-2"
        >
          <BriefcaseIcon className="w-4 h-4 sm:w-5 sm:h-5" />
          View My Work
        </ButtonLink>
      </div>

      <!-- Additional Contact Info -->
      <div class="mt-8 sm:mt-12 pt-6 sm:pt-8 border-t border-neutral-400">
        <p class="text-neutral-600 mb-3 sm:mb-4 text-sm sm:text-base">Need to reach me urgently?</p>
        <a
          href="mailto:kennethpanis24@gmail.com"
          class="text-brand-600 hover:text-brand-700 font-medium transition-colors text-sm sm:text-base break-all"
        >
          kennethpanis24@gmail.com
        </a>
      </div>
    </div>
  </div>
</Layout>
