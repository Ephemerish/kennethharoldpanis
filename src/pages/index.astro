---
export const prerender = true;
import Layout from "../layouts/MainLayout.astro";
import HomeHeader from "../components/HomeHeader.astro";
import EntryCard from "../components/EntryCard.astro";
import { TechCarousel } from "../components/TechCarousel";
import ButtonLink from "../components/ButtonLink.astro";
import PageSection from "../components/PageSection.astro";
import SectionHeader from "../components/SectionHeader.astro";
import { ArrowRightIcon } from "@phosphor-icons/react";
import { HOMEPAGE_BLOG_LIMIT, HOMEPAGE_PROJECTS_LIMIT } from "../constants";

import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";

const allBlogs: CollectionEntry<"blog">[] = (
  await getCollection("blog")
).sort(
  (a: CollectionEntry<"blog">, b: CollectionEntry<"blog">) =>
    b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const allProjects: CollectionEntry<"projects">[] = (
  await getCollection("projects")
).sort((a, b) => {
  if (a.data.featured && !b.data.featured) return -1;
  if (!a.data.featured && b.data.featured) return 1;
  const aDate = a.data.endDate || a.data.startDate;
  const bDate = b.data.endDate || b.data.startDate;
  return bDate.getTime() - aDate.getTime();
});

const mostRecentBlog: CollectionEntry<"blog"> = allBlogs[0];
const otherBlogs: CollectionEntry<"blog">[] = allBlogs.slice(1);
const featuredProject = allProjects[0];
const otherProjects = allProjects.slice(1);
---

<Layout
  title="Kenneth Harold Panis - Full-Stack Developer & Designer"
  description="Full-stack developer and designer specializing in modern web technologies, IoT systems, and mobile applications. Creating beautiful and functional digital experiences."
  image="/images/me/me.jpg"
  type="website"
>
  <HomeHeader />

  <PageSection variant="plain">
    <SectionHeader
      accent="Technologies"
      suffix="I Work With"
      subtitle="I have used these technologies"
    />
    <TechCarousel client:idle />
  </PageSection>

  <PageSection variant="hero">
    <SectionHeader
      prefix="Featured"
      accent="Projects"
      subtitle="Take a look at my recent work and creative solutions that solve real-world problems"
    />

    {featuredProject && (
      <div class="mb-12 sm:mb-16">
        <EntryCard entry={featuredProject} kind="project" variant="featured" />
      </div>
    )}

    {otherProjects.length > 0 && (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 sm:gap-10 mb-8 sm:mb-12">
        {otherProjects
          .slice(0, HOMEPAGE_PROJECTS_LIMIT - 1)
          .map((project: CollectionEntry<"projects">) => (
            <EntryCard entry={project} kind="project" />
          ))
        }
      </div>
    )}

    <div class="text-center">
      <ButtonLink
        href="/projects"
        variant="gradient"
        size="lg"
        class="text-base sm:text-lg font-semibold"
      >
        View All Projects
        <ArrowRightIcon className="ml-3 w-5 h-5" />
      </ButtonLink>
    </div>
  </PageSection>

  <PageSection variant="plain">
    <SectionHeader
      prefix="Latest from the"
      accent="Blog"
      subtitle="Thoughts on development, technology, and lessons learned along the way"
    />

    <div class="mb-12 sm:mb-16">
      <EntryCard entry={mostRecentBlog} kind="blog" variant="featured" />
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 sm:gap-10 mb-8 sm:mb-12">
      {otherBlogs
        .slice(0, HOMEPAGE_BLOG_LIMIT)
        .map((blog) => (
          <EntryCard entry={blog} kind="blog" />
        ))
      }
    </div>

    <div class="text-center">
      <ButtonLink
        href="/blogs"
        variant="outlineBrand"
        size="lg"
        class="text-base sm:text-lg font-semibold"
      >
        Read All Posts
        <ArrowRightIcon className="ml-3 w-5 h-5" />
      </ButtonLink>
    </div>
  </PageSection>
</Layout>
