---
import { Heading, Stack, Text } from "@ui";
import { FileTextIcon as DocumentTextIcon } from "@phosphor-icons/react";
---

<Stack gap="none" align="center" class="text-center py-12 sm:py-16 px-4">
  <DocumentTextIcon className="w-12 h-12 sm:w-16 sm:h-16 mb-4 text-neutral-600" aria-hidden="true" />
  <Heading level={2} size="item" weight="medium" class="mb-2">No blog posts yet</Heading>
  <Text size="body" tone="muted">Check back soon for new content!</Text>
</Stack>
