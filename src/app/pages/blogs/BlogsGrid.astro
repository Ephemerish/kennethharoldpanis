---
import { Grid } from "@ui";
import { FIRST_ROW } from "@app/features/entries/model";
import EntryCard from "@app/features/entries/EntryCard.astro";
import type { CollectionEntry } from "astro:content";

interface Props {
  blogs: CollectionEntry<"blog">[];
}

const { blogs } = Astro.props;
---

<Grid cols="cards-wide">
  {blogs.map((blog, i) => <EntryCard entry={blog} kind="blog" priority={i < FIRST_ROW} />)}
</Grid>
