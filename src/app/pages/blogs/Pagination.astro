---
/** Previous and next for the blog list. Page 1 is /blogs, page n /blogs/page/n. */
import { pageHref } from "./model";

interface Props {
  currentPage: number;
  totalPages: number;
}

const { currentPage, totalPages } = Astro.props;
const disablePrevious = currentPage <= 1;
const disableNext = currentPage >= totalPages;
const base = "inline-block bg-neutral-100 px-3 py-2";
---

<nav class="flex justify-between mt-10" aria-label="Blog pages">
  {disablePrevious ? (
    <span class={`${base} text-neutral-400`} aria-disabled="true">Previous</span>
  ) : (
    <a href={pageHref(currentPage - 1)} rel="prev" class={`${base} hover:bg-neutral-900 hover:text-neutral-0`}>Previous</a>
  )}
  {disableNext ? (
    <span class={`${base} text-neutral-400`} aria-disabled="true">Next</span>
  ) : (
    <a href={pageHref(currentPage + 1)} rel="next" class={`${base} hover:bg-neutral-900 hover:text-neutral-0`}>Next</a>
  )}
</nav>
