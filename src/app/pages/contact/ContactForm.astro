---
import { SubjectSelect } from "./SubjectSelect";
import { Box, Button, Card, Divider, Field, Form, Heading, Input, Text, Textarea } from "@ui";
import { contactLimits } from "@data/settings";
---

<Card variant="floating" padding="lg" class="order-2 lg:order-1">
  <Box class="text-center mb-8">
    <Heading level={2} size="title" class="mb-3">Send me a message</Heading>
    <Text tone="muted">I'll get back to you within 24 hours</Text>
    <Divider width="sm" thickness="thin" class="mt-4" />
  </Box>

  <Form id="contact-form" method="post" gap="xl">
    <Field label="Full Name" for="name" required>
      <Input id="name" required autocomplete="name" maxlength={contactLimits.name} placeholder="Your full name" />
    </Field>

    <Field label="Email Address" for="email" required>
      <Input id="email" type="email" required autocomplete="email" maxlength={contactLimits.email} placeholder="your.email@example.com" />
    </Field>

    <Field label="Subject" for="subject" required>
      <SubjectSelect client:load name="subject" />
    </Field>

    <Field label="Message" for="message" required>
      <Textarea id="message" rows={5} required maxlength={contactLimits.message} placeholder="Tell me about your project, question, or how I can help you..." />
    </Field>

    {/* Left empty by people; bots fill it, and the endpoint drops their message. */}
    <Box class="hidden" aria-hidden="true">
      <Field label="Website" for="website">
        <Input id="website" tabindex="-1" autocomplete="off" />
      </Field>
    </Box>

    <Button type="submit" variant="gradient" class="w-full h-auto py-4 px-6 text-base font-semibold">Send Message</Button>
  </Form>
</Card>

<script>
  import { sendContact } from '@app/api/stores';

  async function showToast(type: 'success' | 'error', title: string, description: string) {
    try {
      const { toast } = await import('sonner');
      if (type === 'success') {
        toast.success(title, { description, duration: 5000 });
      } else {
        toast.error(title, { description, duration: 5000 });
      }
    } catch (error) {
      alert(`${title}: ${description}`);
    }
  }

  // Wire the form once per page, including after a view transition.
  document.addEventListener('astro:page-load', () => {
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  if (form && !form.dataset.wired) {
    form.dataset.wired = 'true';
    form.addEventListener('submit', async function(e) {
      e.preventDefault();

      const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      const originalText = submitBtn.textContent;

      try {
        submitBtn.textContent = 'Sending...';
        submitBtn.disabled = true;

        // Throws when the server refuses, so a failed send is never shown as sent.
        await sendContact(new FormData(form));

        await showToast('success', 'Message sent successfully!', "I'll get back to you soon.");
        form.reset();
      } catch (error) {
        await showToast('error', 'Failed to send message', 'Please try again or email me directly.');
      } finally {
        submitBtn.textContent = originalText;
        submitBtn.disabled = false;
      }
    });
  }
  });

</script>
