---
import Layout from "@app/layout/MainLayout.astro";
import { PageSection, PageHeader } from "@ui";
import { Toaster } from "@ui/components/Toaster";
import ContactForm from "./ContactForm.astro";
import ContactSidebar from "./ContactSidebar.astro";
---

<Layout
  title="Contact - Kenneth Harold Panis"
  description="Get in touch with Kenneth Harold Panis about a role, a freelance project or a collaboration."
  image="/images/me/me.jpg"
  type="website"
>
  <PageSection variant="hero">
    <PageHeader
      prefix="Let's"
      accent="Connect"
      subtitle="Open to roles, freelance work and collaborations. Send a message, or reach me directly."
    />

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 sm:gap-16 lg:gap-20">
      <ContactForm />
      <ContactSidebar />
    </div>
  </PageSection>

  <Toaster
    client:idle
    position="top-right"
    richColors
    closeButton
    expand={false}
    visibleToasts={3}
  />
</Layout>
