---
import { ButtonLink, Card, Heading, Row } from "@ui";

const social = "h-auto gap-2 px-4 py-2 border-2 border-brand-600 text-brand-700 hover:bg-brand-50 hover:border-brand-700 hover:text-brand-800";
import GitHubIcon from "@app/shared/GitHubIcon.astro";
import LinkedInIcon from "@app/shared/LinkedInIcon.astro";
import { socials } from "@data/site";
---

<Card variant="floating">
  <Heading level={2} size="card" class="mb-4 sm:mb-6">Connect with me</Heading>
  <Row gap="lg">
    <ButtonLink href={socials.linkedin} target="_blank" rel="noopener noreferrer" variant="outline" class={social}>
      <LinkedInIcon />
      LinkedIn
    </ButtonLink>
    <ButtonLink href={socials.github} target="_blank" rel="noopener noreferrer" variant="outline" class={social}>
      <GitHubIcon />
      GitHub
    </ButtonLink>
  </Row>
</Card>
