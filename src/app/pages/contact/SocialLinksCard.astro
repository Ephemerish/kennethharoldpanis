---
import { Card } from "@ui";
import GitHubIcon from "@app/shared/GitHubIcon.astro";
import LinkedInIcon from "@app/shared/LinkedInIcon.astro";
import { socials } from "@app/shared/site";
---

<Card variant="floating">
  <h2 class="text-xl sm:text-2xl font-bold text-neutral-900 mb-4 sm:mb-6">Connect with me</h2>

  <div class="flex gap-4">
    <a
      href={socials.linkedin}
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center gap-2 px-4 py-2 bg-neutral-0 border-2 border-brand-600 text-brand-700 hover:bg-brand-50 hover:border-brand-700 hover:text-brand-800 text-sm font-medium"
    >
      <LinkedInIcon />
      LinkedIn
    </a>
    <a
      href={socials.github}
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center gap-2 px-4 py-2 bg-neutral-0 border-2 border-brand-600 text-brand-700 hover:bg-brand-50 hover:border-brand-700 hover:text-brand-800 text-sm font-medium"
    >
      <GitHubIcon />
      GitHub
    </a>
  </div>
</Card>
