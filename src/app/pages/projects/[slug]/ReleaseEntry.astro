---
/**
 * ReleaseEntry, one release's notes on the page.
 *
 * Version chip + date + optional title, then the notes grouped under their
 * change category. Used in the project article's release drawer.
 */
import { Box, Chip, Heading, List, ListItem, Row, Stack, Text } from "@ui";
import { displayVersion, formatReleaseDate, releaseAnchor } from "@data/apps/patch-notes";
import type { ChangeCategory, Release } from "@data/apps/patch-notes";

interface Props {
  release: Release;
  /** App name, used for the deep-link anchor. */
  app: string;
  class?: string;
}

const { release, app, class: extraClass = "" } = Astro.props;

const categoryVariant: Record<
  ChangeCategory,
  "brand" | "neutral" | "success" | "warning" | "error"
> = {
  Added: "success",
  Changed: "brand",
  Deprecated: "neutral",
  Removed: "error",
  Fixed: "warning",
  Security: "error",
  Highlights: "neutral",
};
---

<Box as="article" id={releaseAnchor(app, release.version)} class:list={["scroll-mt-24", extraClass]}>
  <Box as="header">
    <Row wrap gap="none" class="gap-x-3 gap-y-1.5">
      <Chip variant="brand" size="xs">{displayVersion(release.version)}</Chip>
      <Text as="time" datetime={release.date} size="sm" tone="subtle">{formatReleaseDate(release)}</Text>
    </Row>
    {release.title && <Heading level={3} size="item" weight="semibold" class="mt-2 text-xl">{release.title}</Heading>}
  </Box>

  <Stack gap="lg" space="sm">
    {release.changes.map((group) => (
      <Box>
        <Chip variant={categoryVariant[group.category]} size="xs">{group.category}</Chip>
        <List gap="none" class="mt-2.5 space-y-2.5 text-sm text-neutral-700">
          {group.items.map((item) => <ListItem marker="square">{item}</ListItem>)}
        </List>
      </Box>
    ))}
  </Stack>
</Box>
