---
import ReleaseEntry from "./ReleaseEntry.astro";
import { ClockCounterClockwiseIcon, XIcon } from "@phosphor-icons/react";
import {
  displayVersion,
  formatReleaseDate,
  getUpdatesByProject,
} from "@app/data/patch-notes";

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const updates = getUpdatesByProject(slug);
---

{updates && (
  <>
    <button
      type="button"
      class="release-tab"
      data-release-trigger
      aria-haspopup="dialog"
      aria-controls="project-release-notes"
      aria-label={`Open ${updates.app.name} release notes`}
    >
      <ClockCounterClockwiseIcon className="w-5 h-5" aria-hidden="true" />
    </button>
    <span class="release-tooltip" aria-hidden="true">Release notes</span>

    <dialog
      id="project-release-notes"
      class="release-drawer"
      aria-labelledby="release-drawer-title"
      data-release-dialog
    >
      <div class="flex h-full flex-col bg-neutral-0">
        <header class="sticky top-0 z-raised flex items-start justify-between gap-4 border-b border-neutral-200 bg-neutral-0 px-6 py-5 sm:px-8">
          <div>
            <p class="text-xs font-medium uppercase tracking-widest text-neutral-500">{updates.app.name}</p>
            <h2 id="release-drawer-title" class="mt-1 text-xl font-semibold text-neutral-900">Release notes</h2>
            <p class="mt-1 text-sm text-neutral-500">
              Latest: {displayVersion(updates.latest.version)} · {formatReleaseDate(updates.latest)}
            </p>
          </div>
          <button
            type="button"
            class="-mr-2 -mt-1 p-2 text-neutral-500 transition-colors hover:text-neutral-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600"
            aria-label="Close release notes"
            data-release-close
          >
            <XIcon className="w-5 h-5" aria-hidden="true" />
          </button>
        </header>

        <div class="min-h-0 flex-1 overflow-y-auto px-6 py-7 sm:px-8">
          <ReleaseEntry app={updates.app.name} release={updates.latest} />
          {updates.releases.length > 1 && (
            <details class="mt-9 border-t border-neutral-200 pt-5 group">
              <summary class="cursor-pointer text-sm font-medium text-neutral-600 hover:text-neutral-900 focus-visible:outline-2 focus-visible:outline-brand-600">
                Earlier releases ({updates.releases.length - 1})
              </summary>
              <div class="mt-7 space-y-10">
                {updates.releases.slice(1).map((release) => (
                  <ReleaseEntry app={updates.app.name} release={release} />
                ))}
              </div>
            </details>
          )}
        </div>
      </div>
    </dialog>
  </>
)}

<style>
  .release-tab {
    position: fixed;
    z-index: var(--z-float);
    top: 5rem;
    right: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--color-neutral-200);
    background: var(--neutral-0);
    color: var(--color-neutral-600);
    box-shadow: var(--shadow-lg);
  }

  .release-tab:hover, .release-tab:focus-visible { color: var(--color-brand-700); background: var(--color-brand-50); }
  .release-tab:focus-visible { outline: 2px solid var(--color-brand-600); outline-offset: 2px; }

  .release-tooltip {
    position: fixed;
    z-index: var(--z-float);
    top: 5.375rem;
    right: 3.75rem;
    padding: 0.375rem 0.75rem;
    background: var(--neutral-800);
    color: var(--neutral-0);
    font-size: 0.75rem;
    font-weight: 500;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
  }

  .release-tab:hover + .release-tooltip,
  .release-tab:focus-visible + .release-tooltip { opacity: 1; }

  .release-drawer {
    position: fixed;
    inset: 0 0 0 auto;
    width: min(100vw, 34rem);
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0 0 0 auto;
    padding: 0;
    border: 0;
    background: var(--neutral-0);
    box-shadow: var(--shadow-2xl);
  }

  .release-drawer::backdrop { background: color-mix(in srgb, var(--neutral-950) 30%, transparent); }

  @media (min-width: 640px) {
    .release-tab { right: 1rem; width: 3rem; height: 3rem; }
    .release-tooltip { right: 4.5rem; top: 5.5rem; font-size: 0.875rem; }
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const trigger = document.querySelector<HTMLButtonElement>("[data-release-trigger]");
    const dialog = document.querySelector<HTMLDialogElement>("[data-release-dialog]");
    const close = dialog?.querySelector<HTMLButtonElement>("[data-release-close]");
    // Wire each page's drawer once.
    if (!dialog || dialog.dataset.wired) return;
    dialog.dataset.wired = "true";

    trigger?.addEventListener("click", () => dialog?.showModal());
    close?.addEventListener("click", () => dialog?.close());
    dialog?.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog?.addEventListener("close", () => trigger?.focus());
  });
</script>
