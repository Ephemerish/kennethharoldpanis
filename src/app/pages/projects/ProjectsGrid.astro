---
import { Grid } from "@ui";
import EntryCard from "@app/features/entries/EntryCard.astro";
import type { CollectionEntry } from "astro:content";

interface Props {
  projects: CollectionEntry<"projects">[];
}

const { projects } = Astro.props;
---

{projects.length > 0 && (
  <Grid as="section" cols="cards">
    {projects.map((project) => <EntryCard entry={project} kind="project" />)}
  </Grid>
)}
