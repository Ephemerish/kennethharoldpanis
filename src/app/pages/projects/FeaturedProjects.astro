---
import { Stack } from "@ui";
import EntryCard from "@app/features/entries/EntryCard.astro";
import type { CollectionEntry } from "astro:content";

interface Props {
  projects: CollectionEntry<"projects">[];
}

const { projects } = Astro.props;
---

{projects.length > 0 && (
  <Stack as="section" gap="3xl" class="mb-16 sm:mb-20">
    {projects.map((project) => <EntryCard entry={project} kind="project" variant="featured" />)}
  </Stack>
)}
