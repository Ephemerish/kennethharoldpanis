---
import { Card, IconBadge, StatusPill, Chip } from "@ui";
import TechChips from "@app/features/entries/TechChips.astro";
import TagLinks from "@app/features/taxonomy/TagLinks.astro";
import {
  ArrowSquareOutIcon as ArrowTopRightOnSquareIcon,
  StarIcon,
} from "@phosphor-icons/react";
import type { Certification } from "@app/data/certifications";

interface Props {
  cert: Certification;
}

const { cert } = Astro.props;
---

<Card
  id={cert.slug}
  padding="none"
  class="relative flex flex-col overflow-hidden scroll-mt-24"
  hoverable={!!cert.credentialUrl}
>
  {cert.highlighted && (
    <div class="absolute top-4 right-4 z-raised pointer-events-none">
      <StatusPill variant="brand" Icon={StarIcon}>Featured</StatusPill>
    </div>
  )}

  <div class="relative px-6 sm:px-8 pt-8 sm:pt-10 pb-4 flex items-center justify-center">
    <div class:list={[
      "absolute inset-0 blur-2xl",
      cert.accent === "brand" ? "bg-brand-100/40" : "bg-neutral-100/40",
    ]} />
    {cert.badge ? (
      <img
        src={`/images/${cert.badge}`}
        alt={`${cert.title} badge`}
        class="relative w-32 h-32 sm:w-40 sm:h-40 object-contain"
        loading="lazy"
      />
    ) : (
      <IconBadge Icon={cert.Icon} variant={cert.accent} size="xl" class="relative shadow-lg" />
    )}
  </div>

  <div class="px-6 sm:px-8 pb-6 sm:pb-8 flex-1 flex flex-col">
    <div class="text-center mb-5">
      <h3 class="text-xl sm:text-2xl font-bold text-neutral-900 mb-2 leading-tight group-hover:text-brand-700">
        {cert.title}
      </h3>
      <p class="text-sm sm:text-base text-neutral-600 font-medium">
        {cert.issuer}
        {cert.issuedDate && (
          <span class="text-neutral-400"> · {cert.issuedDate}</span>
        )}
      </p>
    </div>

    <p class="text-sm sm:text-base text-neutral-700 mb-5 leading-relaxed">
      {cert.summary}
    </p>

    <div class="mb-5">
      <p class="text-xs font-semibold uppercase tracking-wider text-neutral-500 mb-3">
        Focus areas
      </p>
      <div class="flex flex-wrap gap-2">
        {cert.focusAreas.map((area) => (
          <Chip variant={cert.chipVariant}>{area}</Chip>
        ))}
      </div>
    </div>

    {cert.tech && (
      <div class="relative z-raised mb-5">
        <p class="text-xs font-semibold uppercase tracking-wider text-neutral-500 mb-3">
          Related tech
        </p>
        <TechChips tech={cert.tech} size="sm" />
      </div>
    )}

    <div class="relative z-raised mb-5">
      <TagLinks tags={cert.tags} size="sm" />
    </div>

    <div class="flex-1" />

    {cert.credentialUrl && (
      <a
        href={cert.credentialUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="stretched-link flex items-center justify-center gap-1.5 mt-4 pt-4 border-t border-neutral-100 text-sm font-semibold text-brand-700 group-hover:text-brand-800"
      >
        <span>Verify credential</span>
        <ArrowTopRightOnSquareIcon className="w-4 h-4" aria-hidden="true" />
        <span class="sr-only">for {cert.title} (opens in a new tab)</span>
      </a>
    )}
  </div>
</Card>
