---
/** Work and school, newest first. The current role starts open. */
import { getCollection } from "astro:content";
import { Box, ListItem, List, SectionHeader } from "@ui";
import { timeline } from "@data/bio/experience";
import RoleItem from "./RoleItem.astro";
import { techUsed } from "./model";

const entries = [...(await getCollection("projects")), ...(await getCollection("blog"))];
---

<Box as="section" aria-labelledby="experience">
  <SectionHeader prefix="My" accent="Experience" subtitle="Where I've worked and studied. Open one to see the tech I used there." id="experience" />
  <List gap="md">
    {timeline.map((role) => (
      <ListItem><RoleItem role={role} tech={techUsed(role, entries)} /></ListItem>
    ))}
  </List>
</Box>
