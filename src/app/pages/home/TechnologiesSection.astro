---
/** Every technology, as two rows that drift in opposite directions (KHP §5.8). */
import { Marquee, PageSection, SectionHeader, Stack } from "@ui";
import { technologies, type Technology } from "@data/taxonomy/technologies";
import TechTile from "./TechTile.astro";

const all: readonly Technology[] = technologies;
const split = Math.ceil(all.length / 2);
const rows = [all.slice(0, split), all.slice(split)];
// About 2.6s per tile keeps both rows at the same, unhurried speed.
const seconds = (count: number) => Math.round(count * 2.6);
---

<PageSection variant="plain">
  <SectionHeader
    accent="Technologies"
    suffix="I Work With"
    subtitle="Each one opens the projects, posts and roles where I used it."
  />
  <Stack gap="md" aria-label="Technologies">
    {rows.map((row, i) => (
      <Marquee seconds={seconds(row.length)} reverse={i % 2 === 1}>
        {row.map((tech) => <TechTile tech={tech} />)}
      </Marquee>
    ))}
  </Stack>
</PageSection>
