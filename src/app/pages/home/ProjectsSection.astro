---
import { Box, ButtonLink, Grid, PageSection, Row, SectionHeader } from "@ui";
import EntryCard from "@app/features/entries/EntryCard.astro";
import { ArrowRightIcon } from "@phosphor-icons/react";
import { lists } from "@data/settings";
import { getCollection } from "astro:content";
import { sortProjects } from "@app/features/entries/model";

const [featuredProject, ...otherProjects] = sortProjects(await getCollection("projects"));
---

<PageSection variant="hero">
  <SectionHeader
    prefix="Featured"
    accent="Projects"
    subtitle="From a LoRa network for small fishing boats to the apps I build and run myself."
  />

  {featuredProject && (
    <Box class="mb-12 sm:mb-16">
      <EntryCard entry={featuredProject} kind="project" variant="featured" />
    </Box>
  )}

  {otherProjects.length > 0 && (
    <Grid cols="cards" class="mb-8 sm:mb-12">
      {otherProjects.slice(0, lists.homeProjects - 1).map((project) => <EntryCard entry={project} kind="project" />)}
    </Grid>
  )}

  <Row justify="center">
    <ButtonLink href="/projects" variant="gradient" size="lg" class="text-base sm:text-lg font-semibold">
      View All Projects
      <ArrowRightIcon className="ml-3 w-5 h-5" aria-hidden="true" />
    </ButtonLink>
  </Row>
</PageSection>
