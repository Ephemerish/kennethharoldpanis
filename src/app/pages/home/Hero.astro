---
import { currentRole } from "@data/bio/experience";
import { Box, ButtonLink, Chip, Frame, Heading, Image, List, ListItem, Row, Stack, Text } from "@ui";
import { certifications } from "@data/bio/certifications";

// Who he is now and what he is certified in, straight from the bio's data.
const current = currentRole;
---

<Frame backdrop="hero" pad="lg" class="w-full">
  <Row stackBelow="md" justify="center" gap="none" class="gap-8 md:gap-12">
    <Row justify="center" class="order-1 md:order-2">
      <Box class="relative w-[200px] h-[200px] sm:w-[250px] sm:h-[250px] md:w-[300px] md:h-[300px] lg:w-[350px] lg:h-[350px] overflow-hidden border-4 border-brand-600">
        <Image src="/images/me/me.jpg" alt="Kenneth Harold Panis" width="350" height="350" fit="cover" priority class="w-full h-full" />
      </Box>
    </Row>

    <Stack gap="xl" class="order-2 md:order-1 flex-1 justify-center text-center md:text-left">
      <Stack gap="lg">
        <Heading level={1} size="hero">
          Hi, I'm <Text as="span" tone="inherit" class="text-brand-600">Kenneth</Text>
        </Heading>
        {current && (
          <Text size="lead" tone="strong" weight="semibold" class="text-neutral-800">{current.title} at {current.org}</Text>
        )}
        <Text size="lead" tone="muted" class="max-w-[600px] mx-auto md:mx-0">
          I'm drawn to creating things that solve random problems and bring ideas to life.
        </Text>
        <Text size="lead" tone="muted" class="max-w-[600px] mx-auto md:mx-0">
          I have a plan to create projects, and this is where all my thoughts and projects will be on display,
          everything from weekend experiments to things I'm actually proud of or not, we'll see.
        </Text>
      </Stack>

      {certifications.length > 0 && (
        <List direction="row" gap="sm" class="justify-center md:justify-start" aria-label="Certifications">
          {certifications.map((cert) => (
            <ListItem>
              <Chip
                variant="brand"
                size="sm"
                href={`/bio#${cert.slug}`}
                title={cert.title}
                logo={cert.image}
                class="gap-2 py-1.5 hover:bg-brand-100 hover:border-brand-300"
              >
                {cert.shortTitle}
              </Chip>
            </ListItem>
          ))}
        </List>
      )}

      <Row stackBelow="sm" gap="md" class="mt-6 sm:mt-8 w-full sm:w-auto">
        <ButtonLink href="/contact" class="w-full sm:w-auto h-auto px-6 py-3 text-sm sm:text-base">
          Get In Touch
        </ButtonLink>
        <ButtonLink href="/projects" variant="outline" class="w-full sm:w-auto h-auto px-6 py-3 border-2 border-neutral-300 text-neutral-900 text-sm sm:text-base">
          View Projects
        </ButtonLink>
      </Row>
    </Stack>
  </Row>
</Frame>
