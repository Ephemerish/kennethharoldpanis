---
/** The home page. */
import Layout from "@app/layout/MainLayout.astro";
import Hero from "./Hero.astro";
import TechnologiesSection from "./TechnologiesSection.astro";
import ProjectsSection from "./ProjectsSection.astro";
import BlogSection from "./BlogSection.astro";
import { currentRole } from "@data/bio/experience";

const role = currentRole ? `${currentRole.title.toLowerCase()} at ${currentRole.org}` : "software engineer";
const description = `Kenneth Harold Panis, ${role}. Web apps he builds and runs, a LoRa network for small fishing boats, write-ups, and AWS, Google Cloud and FinOps certifications.`;
---

<Layout
  title="Kenneth Harold Panis - Software Engineer"
  description={description}
  image="/images/me/me.jpg"
  type="website"
>
  <Hero />
  <TechnologiesSection />
  <ProjectsSection />
  <BlogSection />
</Layout>
