---
import { Chip, List, ListItem } from "@ui";
import { getTagLabel } from "@data/taxonomy/tags";

const { tags } = Astro.props;

interface Props {
  tags: string[];
}

// Plain (non-link) chips: this renders inside the card's anchor, so it can't
// nest links. Clickable tags live on the detail pages and /tags.
---

<List direction="row" gap="none" class="gap-1">
  {tags.map((tag) => (
    <ListItem><Chip variant="tag" size="tag" dot>{getTagLabel(tag)}</Chip></ListItem>
  ))}
</List>
