---
import { Grid } from "@ui";
import EntryCard from "./EntryCard.astro";
import { FIRST_ROW } from "./model";
import type { CollectionEntry } from "astro:content";

type Tagged =
  | { entry: CollectionEntry<"projects">; kind: "project" }
  | { entry: CollectionEntry<"blog">; kind: "blog" };

interface Props {
  entries: Tagged[];
}

const { entries } = Astro.props;
---

<Grid cols="cards" gap="2xl">
  {entries.map(({ entry, kind }, i) => (
    <EntryCard entry={entry} kind={kind} priority={i < FIRST_ROW} />
  ))}
</Grid>
