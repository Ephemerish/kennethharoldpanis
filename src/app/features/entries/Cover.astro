---
/**
 * Cover, the picture at the top of an EntryCard, 16:9.
 *
 * An entry whose article engine draws a live cover (pretext) paints a still
 * of its strips at once; the live canvas hydrates over it only when the card
 * scrolls into view (KHP §5.8, §7.6). Any other entry shows its image, whole,
 * over a blurred backdrop of itself, so a picture of any shape fills the frame.
 */
import PretextCover from "@app/features/article/PretextCover";
import { engineHasLiveCover } from "@app/features/article/engines";
import { coverBackdrop } from "./cover-image.mjs";
import { Box, Image } from "@ui";

interface Props {
  title: string;
  image?: string;
  engine?: string;
  /** In the first row: load first instead of lazily (KHP §7.7). */
  priority?: boolean;
}

const { title, image, engine, priority = false } = Astro.props;
const live = engineHasLiveCover(engine);

const PHRASES = ["WORDS FIND THEIR WAY", "MEASURE WRAP FLOW", "TYPE IN MOTION", "EVERY LETTER COUNTS", "LINES BECOME SHAPES", "MAKE ROOM FOR WORDS"];
const strips = Array.from({ length: 18 }, (_, i) => ({
  text: Array(3).fill(PHRASES[(i * 5) % PHRASES.length]).join(" · "),
  style: `--column:${i};--offset:${((i * 37) % 110) - 65}px;--tilt:${[4, -5, 2, -3, 6, -2][i % 6]}deg;--ink:${[0.55, 0.85, 0.4, 0.7][i % 4]}`,
}));
---

{live ? (
  <Box class="pretext-still relative aspect-video w-full overflow-hidden" data-pretext-still aria-hidden="true">
    {strips.map((strip) => <Box as="span" class="pretext-strip" style={strip.style}>{strip.text}</Box>)}
    <Box class="absolute inset-0"><PretextCover client:visible title={title} showTitle={false} /></Box>
  </Box>
) : (
  <Box class="relative aspect-video w-full overflow-hidden bg-neutral-900">
    {image && (
      <>
        <Image src={coverBackdrop(image)} alt="" aria-hidden="true" fit="cover" priority={priority} class="absolute inset-0 h-full w-full opacity-70" />
        <Image src={`/images/${image}`} alt="" fit="contain" priority={priority} class="relative h-full w-full" />
      </>
    )}
  </Box>
)}

<style>
  .pretext-still {
    background: radial-gradient(ellipse at 65% 25%, var(--art-forest), var(--art-night) 75%);
  }
  .pretext-strip {
    position: absolute;
    top: var(--offset);
    left: calc(var(--column) * 5.7% - 1%);
    width: 2.1%;
    min-width: 12px;
    height: 130%;
    overflow: hidden;
    padding: 14px 3px;
    border-inline: 1px solid color-mix(in srgb, var(--art-glow) 14%, transparent);
    background: linear-gradient(90deg, var(--art-strip-1), var(--art-strip-2) 45%, var(--art-strip-3));
    color: var(--art-glow);
    font: 600 clamp(8px, 1vw, 13px) / 1.7 var(--font-mono);
    letter-spacing: 0.22em;
    writing-mode: vertical-rl;
    text-orientation: upright;
    opacity: var(--ink);
    transform: rotate(var(--tilt));
    transform-origin: top center;
  }
</style>
