---
/**
 * EntryCard, the one card for a project or a post, everywhere it's listed
 * (KHP §4.10). Featured projects and the newest post use it too: they come
 * first in the list, they don't look different.
 *
 * The whole card is one link (KHP §4.4). Reads `CardData` from `toCard`, so it
 * never branches on the kind: a project brings its status, a post its read
 * time, and both show in the same places.
 */
import { ArrowRightIcon, CalendarBlankIcon, ClockIcon } from "@phosphor-icons/react";
import { Box, Card, Chip, Heading, IconText, List, ListItem, Row, Stack, StatusPill, Text } from "@ui";
import { formatDate, isoDay } from "@app/calc/format";
import { getTagLabel } from "@data/taxonomy/tags";
import Cover from "./Cover.astro";
import type { CardData } from "./model";

interface Props {
  card: CardData;
  priority?: boolean;
}

const { card, priority = false } = Astro.props;
---

<Card href={card.href} hoverable padding="none" class="flex h-full flex-col overflow-hidden">
  <Box class="relative">
    <Cover title={card.title} image={card.image} engine={card.engine} priority={priority} />
    {card.status && (
      <StatusPill variant={card.status.variant} class="absolute right-4 top-4 border">{card.status.label}</StatusPill>
    )}
  </Box>

  <Stack gap="md" grow class="p-6 sm:p-8">
    <Heading level={2} size="card" class="line-clamp-2 group-hover:text-brand-700">{card.title}</Heading>

    <Row wrap gap="md" class="text-sm text-neutral-600">
      <IconText Icon={CalendarBlankIcon} as="time" datetime={isoDay(card.date)}>{formatDate(card.date)}</IconText>
      {card.readTime && <IconText Icon={ClockIcon}>{card.readTime}</IconText>}
    </Row>

    {card.summary && <Text size="sm" tone="muted" clamp={3}>{card.summary}</Text>}

    {card.tags.length > 0 && (
      <List direction="row" gap="none" class="gap-1">
        {card.tags.map((tag) => <ListItem><Chip variant="tag" size="tag" dot>{getTagLabel(tag)}</Chip></ListItem>)}
      </List>
    )}

    <Row gap="sm" class="mt-auto border-t border-neutral-200 pt-4 text-sm font-medium text-neutral-900 group-hover:text-brand-700" aria-hidden="true">
      <Text as="span" tone="inherit">{card.action}</Text>
      <ArrowRightIcon className="h-4 w-4" />
    </Row>
  </Stack>
</Card>
