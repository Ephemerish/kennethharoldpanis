---
/**
 * EntryCard, the ONE card for blog posts and projects.
 *
 * `kind`     "blog" | "project", which collection the entry is from
 * `variant`  "default" | "featured"
 *              default  = grid card (used in listings/grids)
 *              featured = full-width hero card (the lead/featured slot)
 *
 * One component so blog and project cards stay identical in structure and
 * styling. Kind-specific bits (status vs read-time, description, links) are
 * the only differences. Change the look here once and everything follows.
 */
import { formatDate, isoDay, readTime as calculateReadTime } from "@app/calc/format";
import type { CollectionEntry } from "astro:content";
import { getTagLabel } from "@app/data/tags";
import Cover from "./Cover.astro";
import Tags from "./Tags.astro";
import { PROJECT_STATUS } from "./model";
import {
  CalendarBlankIcon as CalendarIcon,
  ClockIcon,
  ArrowRightIcon,
  GithubLogoIcon as GithubIcon,
  StarIcon,
  RocketLaunchIcon,
  BookOpenIcon,
} from "@phosphor-icons/react";

interface Props {
  entry: CollectionEntry<"blog"> | CollectionEntry<"projects">;
  kind: "blog" | "project";
  variant?: "default" | "featured";
}

const { entry, kind, variant = "default" } = Astro.props;
const isBlog = kind === "blog";

const title = entry.data.title;
const image = entry.data.image;
const tags = entry.data.tags ?? [];
const href = `${isBlog ? "/blogs" : "/projects"}/${entry.slug}`;

const blog = isBlog ? (entry.data as CollectionEntry<"blog">["data"]) : null;
const project = !isBlog ? (entry.data as CollectionEntry<"projects">["data"]) : null;
const readTime = isBlog ? calculateReadTime(entry.body) : null;

const date = isBlog ? blog!.pubDate : project!.endDate ?? project!.startDate;
// The engine ("type") tells <Cover /> how to render: live demo vs static image.
const coverEngine = isBlog ? blog!.engine : undefined;
const ctaLabel = isBlog ? "Read post" : "View project";
// The corner pill says why this card leads: a project the owner marked
// featured, or the newest post. Never a label the data doesn't back.
const lead = isBlog
  ? { Icon: BookOpenIcon, label: "Latest post", weight: "regular" as const }
  : project?.featured
    ? { Icon: StarIcon, label: "Featured", weight: "fill" as const }
    : null;
---

{variant === "featured" ? (
  <article class="relative w-full group cursor-pointer overflow-hidden shadow-elegant border-2 border-transparent hover:border-brand-500 hover:shadow-floating motion-lift">
    <a href={href} class="block">
      <div class="relative">
        <Cover
          engine={coverEngine}
          image={image}
          title={title}
          loading="eager"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/35 to-transparent group-hover:from-black/75 group-hover:via-black/25 pointer-events-none"></div>

        {/* Why it leads, and the project's status */}
        {lead && (
          <div class="absolute top-4 left-4 sm:top-6 sm:left-6 flex items-center gap-1.5 bg-brand-700 text-white px-3 py-1.5 sm:px-4 sm:py-2 text-xs sm:text-sm font-semibold shadow-lg">
            <lead.Icon className="w-4 h-4" weight={lead.weight} aria-hidden="true" />
            {lead.label}
          </div>
        )}
        {project && (
          <div class={`absolute top-4 right-4 sm:top-6 sm:right-6 px-3 py-1.5 sm:px-4 sm:py-2 text-xs sm:text-sm font-semibold border shadow-lg ${PROJECT_STATUS[project.status].class}`}>
            {PROJECT_STATUS[project.status].label}
          </div>
        )}

        <div class="absolute inset-0 flex flex-col justify-end p-5 sm:p-8 lg:p-10 text-white pointer-events-none">
          <div class="max-w-4xl">

            <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold mb-3 sm:mb-4 leading-tight group-hover:text-brand-300">
              {title}
            </h2>

            <div class="flex flex-wrap items-center gap-x-4 gap-y-2 mb-4 sm:mb-5 text-white/80 text-sm">
              <time datetime={isoDay(date)} class="flex items-center gap-1.5">
                <CalendarIcon className="w-4 h-4" />
                {formatDate(date)}
              </time>
              {readTime && (
                <span class="flex items-center gap-1.5">
                  <ClockIcon className="w-4 h-4" />
                  {readTime}
                </span>
              )}
              {project?.overview?.academic?.institution && (
                <span class="hidden sm:inline">{project.overview.academic.institution}</span>
              )}
            </div>

            {project?.description && (
              <p class="hidden sm:block text-base lg:text-lg text-white/90 mb-5 leading-relaxed max-w-3xl line-clamp-2">
                {project.description}
              </p>
            )}

            <div class="flex flex-wrap gap-2 mb-5">
              {tags.slice(0, 4).map((tag) => (
                <span class="px-3 py-1 bg-white/20 text-sm font-medium">
                  {getTagLabel(tag)}
                </span>
              ))}
              {tags.length > 4 && (
                <span class="px-3 py-1 bg-white/20 text-sm font-medium">
                  +{tags.length - 4} more
                </span>
              )}
            </div>

            <div class="flex items-center text-sm sm:text-base font-semibold group-hover:text-brand-300">
              <span>{ctaLabel}</span>
              <ArrowRightIcon className="w-5 h-5 ml-2" />
            </div>
          </div>
        </div>
      </div>
    </a>
  </article>
) : (
  <article class="relative group bg-card-gradient overflow-hidden shadow-elegant border border-neutral-200/50 hover:bg-neutral-0 hover:border-brand-300/60 hover:shadow-floating motion-lift cursor-pointer h-full flex flex-col">
    <div class="flex-1 flex flex-col">
      <div class="relative overflow-hidden">
        <div class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-black/20 z-raised pointer-events-none"></div>
        <Cover engine={coverEngine} image={image} title={title} loading="lazy" />

        {readTime && (
          <div class="absolute top-4 right-4 bg-neutral-0 px-3 py-1.5 text-xs font-semibold text-neutral-700 border border-neutral-200/50 shadow-sm z-raised pointer-events-none flex items-center gap-1.5">
            <ClockIcon className="w-3.5 h-3.5" />
            {readTime}
          </div>
        )}

        {project && (
          <div class={`absolute top-4 right-4 px-3 py-1.5 text-xs font-semibold border shadow-sm z-raised pointer-events-none ${PROJECT_STATUS[project.status].class}`}>
            {PROJECT_STATUS[project.status].label}
          </div>
        )}
      </div>

      <div class="p-6 sm:p-8 flex-1 flex flex-col">
        <h2 class="text-xl sm:text-2xl font-bold text-neutral-900 mb-3 line-clamp-2 group-hover:text-brand-700 leading-tight">
          <a href={href} class="stretched-link">{title}</a>
        </h2>

        <div class="flex items-center gap-1.5 text-sm text-neutral-500 mb-4">
          <CalendarIcon className="w-4 h-4" />
          <time datetime={isoDay(date)}>{formatDate(date)}</time>
        </div>

        {project?.description && (
          <p class="text-neutral-600 text-sm mb-4 line-clamp-3">
            {project.description}
          </p>
        )}

        {project?.links?.code && (
          <div class="flex gap-3 mb-4 text-sm">
            <a href={project.links.code} target="_blank" rel="noopener noreferrer" class="relative z-raised text-neutral-600 hover:text-neutral-800 font-medium flex items-center gap-1">
              <GithubIcon className="w-3.5 h-3.5" />
              Code
            </a>
          </div>
        )}

        <div class="mb-4">
          <Tags tags={tags} />
        </div>

        <div class="flex-1"></div>

        <div class="flex items-center text-neutral-900 text-sm font-medium pt-3 border-t border-neutral-100 group-hover:text-brand-700 mt-auto" aria-hidden="true">
          <span>{ctaLabel}</span>
          <ArrowRightIcon className="w-4 h-4 ml-1.5" />
        </div>
      </div>
    </div>
  </article>
)}
