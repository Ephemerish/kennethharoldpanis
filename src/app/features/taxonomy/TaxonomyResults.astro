---
/**
 * What a tag or technology is attached to: projects and posts as cards, then
 * the roles and certifications on the bio that carry it.
 */
import { Box, Button, Grid, Label, ListItem, Row } from "@ui";
import EntryGrid from "@app/features/entries/EntryGrid.astro";
import BioRecordCard from "./BioRecordCard.astro";
import type { AnyEntry } from "@app/features/entries/model";
import type { BioRecord } from "./collect";

interface Props {
  entries: AnyEntry[];
  bio: BioRecord[];
}

const { entries, bio } = Astro.props;
---

{entries.length > 0 && <EntryGrid entries={entries} />}

{bio.length > 0 && (
  <Box as="section" space={entries.length > 0 ? "2xl" : "none"} aria-labelledby="from-bio">
    <Label as="h2" id="from-bio" class="mb-6">From my bio</Label>
    <Grid as="ul" cols="cards" gap="lg">
      {bio.map((item) => <ListItem><BioRecordCard item={item} /></ListItem>)}
    </Grid>
  </Box>
)}

<Row justify="center" space="xl">
  <Button variant="link" class="h-auto px-0 text-brand-700 hover:text-brand-800 no-underline hover:no-underline" onclick="window.dispatchEvent(new CustomEvent('open-search'))">
    Search for something else
  </Button>
</Row>
