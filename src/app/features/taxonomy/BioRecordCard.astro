---
/**
 * A role or certification on a tag or tech page: what it is, where, when, and
 * a link to its card on /bio.
 */
import { ArrowRightIcon } from "@phosphor-icons/react";
import { Card, Heading, IconBadge, Label, Stack, Text } from "@ui";
import { hrefOf, type BioRecord } from "./collect";
import { yearsLabel } from "@data/bio/experience";

interface Props {
  item: BioRecord;
}

const { item } = Astro.props;
const isRole = item.kind === "experience";
const title = item.record.title;
const where = isRole ? item.record.org : item.record.issuer;
const when = isRole
  ? yearsLabel(item.record)
  : item.record.issuedDate;
const label = isRole ? "Experience" : "Certification";
---

<Card href={hrefOf(item)} hoverable padding="sm" class="motion-lift flex h-full items-start gap-4">
  <IconBadge Icon={item.record.Icon} variant="subtle" size="sm" weight="regular" />
  <Stack gap="none" class="min-w-0 flex-1">
    <Label tone="brand">{label}</Label>
    <Heading level={3} size="small" class="mt-1 group-hover:text-brand-700">{title}</Heading>
    <Text size="sm" tone="muted" class="mt-0.5">
      {where}{when && <Text as="span" tone="subtle"> · {when}</Text>}
    </Text>
  </Stack>
  <ArrowRightIcon className="mt-1 h-4 w-4 shrink-0 text-neutral-400 group-hover:text-brand-700" aria-hidden="true" />
</Card>
