---
/** The footer: the name, ways to reach him, and the contact button (KHP §2.1). */
import { ButtonLink, Frame, Link, Row, Text } from "@ui";
import GitHubIcon from "@app/shared/GitHubIcon.astro";
import LinkedInIcon from "@app/shared/LinkedInIcon.astro";
import EnvelopeIcon from "@app/shared/EnvelopeIcon.astro";
import EmailLink from "@app/shared/EmailLink.astro";
import { site, socials } from "@data/site";
---

<Frame as="footer" topBorder pad="sm" class="text-neutral-900">
  <Row stackBelow="md" gap="lg" justify="between" align="start" class="md:items-center">
    <Text size="inherit" tone="inherit" weight="bold" class="text-lg text-brand-gradient whitespace-nowrap">{site.name}</Text>

    <Row gap="lg">
      <Row gap="md" class="sm:gap-3">
        <Link href={socials.github} external tone="quiet" aria-label="GitHub"><GitHubIcon class="w-5 h-5" /></Link>
        <Link href={socials.linkedin} external tone="quiet" aria-label="LinkedIn"><LinkedInIcon class="w-5 h-5" /></Link>
        <EmailLink class="text-neutral-500 hover:text-brand-700" ariaLabel="Email"><EnvelopeIcon class="w-7 h-7" /></EmailLink>
      </Row>
      <ButtonLink href="/contact" class="gap-2 h-auto py-2">
        <EnvelopeIcon class="w-4 h-4" />
        Get in Touch
      </ButtonLink>
    </Row>
  </Row>
</Frame>
