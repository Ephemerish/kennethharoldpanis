---
/**
 * MainLayout, the frame around every page (KHP §2.1): head, navigation, the
 * page, footer. The navigation persists across view transitions.
 */
import "@ui/tokens/theme.css";
import { ClientRouter } from "astro:transitions";
import Head, { type Props as HeadProps } from "./Head.astro";
import Navbar from "./Navbar";
import Footer from "./Footer.astro";
import Analytics from "@app/features/analytics/Analytics.astro";

type Props = HeadProps;

const props = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <Head {...props} />
    <!-- Smooth same-origin page transitions; persists nav state across navigations -->
    <ClientRouter />
  </head>
  <body class="w-full min-h-screen flex flex-col bg-neutral-0 antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-toast focus:bg-brand-700 focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-neutral-0"
    >
      Skip to content
    </a>
    <Navbar client:idle path={Astro.url.pathname} transition:persist />
    <main id="main" class="flex-1 relative flex flex-col">
      <slot />
      <!-- On a short page, the side rules run on down to the footer. -->
      <div class="relative flex-1" aria-hidden="true">
        <div class="absolute inset-0">
          <div class="max-w-7xl mx-auto h-full px-4 sm:px-6 lg:px-8">
            <div class="border-l border-r border-neutral-200 h-full"></div>
          </div>
        </div>
      </div>
    </main>
    <Footer />
    <Analytics />
  </body>
</html>
