---
/**
 * ArticleLayout, the shared page shell for any long-form entry.
 *
 * Blog posts and projects both render through this layout so the page
 * chrome (bordered shell, header, meta row, hero image, back-nav, footer)
 * and the content engine (<Prose />) are defined once. Collection-specific
 * UI (e.g. a project's overview cards) is passed via the `before-content`
 * and `actions` slots.
 */
import MainLayout from "./MainLayout.astro";
import Prose from "../components/Prose.astro";
import ContentImageViewer from "../components/ContentImageViewer.tsx";
import TechChips from "../components/TechChips.astro";
import { formatDate } from "../utils";
import { getTagLabel } from "../data/tags";
import { CalendarBlankIcon as CalendarIcon, ClockIcon } from "@phosphor-icons/react";

interface Badge {
  label: string;
  class: string;
}

interface Props {
  title: string;
  description?: string;
  heroImage?: string;
  ogType?: string;
  date?: Date;
  readTime?: string;
  tags?: string[];
  tech?: string[];
  badges?: Badge[];
  // When false, the default slot is rendered as-is instead of being wrapped in
  // <Prose>. Lets a custom engine (e.g. pretext) own the whole body render.
  proseBody?: boolean;
  // When false, the hero image is not rendered, but heroImage is still used as
  // the OG/share image. Lets the pretext post skip a redundant cover on-page.
  showHero?: boolean;
}

const {
  title,
  description,
  heroImage,
  ogType = "article",
  date,
  readTime,
  tags,
  tech,
  badges,
  proseBody = true,
  showHero = true,
} = Astro.props;

const hasFacets = (tech && tech.length > 0) || (tags && tags.length > 0);

const ogImage = heroImage ? `/images/${heroImage}` : "/images/me/me.jpg";
const hasActions = Astro.slots.has("actions");
const hasLead = Astro.slots.has("lead");
const hasAppendix = Astro.slots.has("appendix");
---

<MainLayout title={title} description={description} image={ogImage} type={ogType}>
  <section class="bg-white text-neutral-900 relative overflow-hidden">
    <div class="absolute inset-0">
      <div class="max-w-7xl mx-auto h-full px-4 sm:px-6 lg:px-8">
        <div class="bg-neutral-0 border-l border-r border-neutral-200 h-full"></div>
      </div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 relative">
      <div class="px-4 sm:px-6 lg:px-8">
        <article>
          <header class="mb-8">
            {/* Title + badges */}
            <div class="flex flex-wrap items-center gap-3 mb-4">
              <h1 class="text-4xl md:text-5xl font-bold text-neutral-900 leading-tight">
                {title}
              </h1>
              {badges?.map((badge) => (
                <span class={`px-3 py-1 text-sm font-medium ${badge.class}`}>
                  {badge.label}
                </span>
              ))}
            </div>

            {/* Meta row: date + read time */}
            <div class="flex items-center gap-4 text-neutral-700 mb-6">
              {date && (
                <time class="flex items-center gap-1.5 text-sm">
                  <CalendarIcon className="w-4 h-4" />
                  {formatDate(date)}
                </time>
              )}
              {date && readTime && <span class="text-neutral-400">•</span>}
              {readTime && (
                <span class="flex items-center gap-1.5 text-sm">
                  <ClockIcon className="w-4 h-4" />
                  {readTime}
                </span>
              )}
            </div>

            {/* Optional description */}
            {description && (
              <p class="text-xl text-neutral-700 mb-8 leading-relaxed">
                {description}
              </p>
            )}

            {/* Hero image */}
            {heroImage && showHero && (
              <div class="relative w-full aspect-video overflow-hidden shadow-lg mb-8 bg-neutral-950">
                <img
                  src={`/images/${heroImage}`}
                  alt=""
                  aria-hidden="true"
                  class="absolute inset-0 w-full h-full object-cover scale-110 blur-2xl opacity-70"
                />
                <img
                  id="article-hero"
                  src={`/images/${heroImage}`}
                  alt={title}
                  class="relative w-full h-full object-contain"
                  loading="eager"
                />
              </div>
            )}

            {/* Collection-specific actions (e.g. project demo/github buttons) */}
            {hasActions && (
              <div class="flex flex-wrap gap-3">
                <slot name="actions" />
              </div>
            )}

            {/* Shared facets — identical for blogs and projects */}
            {hasFacets && (
              <div class="mt-8 pt-6 border-t border-neutral-200 space-y-4">
                {tech && tech.length > 0 && (
                  <div class="flex flex-col sm:flex-row sm:items-baseline gap-2 sm:gap-5">
                    <span class="text-[11px] font-semibold uppercase tracking-wider text-neutral-400 sm:w-20 shrink-0">
                      Built with
                    </span>
                    <TechChips tech={tech} />
                  </div>
                )}
                {tags && tags.length > 0 && (
                  <div class="flex flex-col sm:flex-row sm:items-baseline gap-2 sm:gap-5">
                    <span class="text-[11px] font-semibold uppercase tracking-wider text-neutral-400 sm:w-20 shrink-0">
                      Tagged
                    </span>
                    <div class="flex flex-wrap gap-2">
                      {tags.map((tag) => (
                        <a
                          href={`/tags/${tag}`}
                          class="px-3 py-1.5 text-sm font-medium text-brand-700 bg-brand-50 border border-brand-200 hover:bg-brand-100"
                        >
                          {getTagLabel(tag)}
                        </a>
                      ))}
                    </div>
                  </div>
                )}
              </div>
            )}
          </header>

          {/* Lead: visuals / quick context shown before the story */}
          {hasLead && (
            <div class="mb-12 space-y-8">
              <slot name="lead" />
            </div>
          )}

          {/* Content engine: Prose by default, or raw for a custom engine */}
          {proseBody ? (
            <Prose>
              <slot />
            </Prose>
          ) : (
            <slot />
          )}

          {/* Optional compact appendix, kept below the story */}
          {hasAppendix && (
            <section class="mt-16 pt-8 border-t border-neutral-200">
              <h2 class="text-xs font-semibold uppercase tracking-wider text-neutral-400 mb-8">
                Details
              </h2>
              <slot name="appendix" />
            </section>
          )}

        </article>
      </div>
    </div>

    {/* Wires the hero + every markdown image to the zoomable viewer */}
    <ContentImageViewer client:idle />
  </section>
</MainLayout>
