---
/** Input, a one-line text field in the shared field style. */
import type { HTMLAttributes } from "astro/types";
import { cn } from "../../utils/cn";
import { FIELD_CLASS } from "./field";

type Props = HTMLAttributes<"input"> & {
  id: string;
  name?: string;
  type?: "text" | "email" | "url" | "tel" | "search";
  class?: string;
};

const { id, name = id, type = "text", class: className, ...rest } = Astro.props;
---

<input id={id} name={name} type={type} class={cn(FIELD_CLASS, className)} {...rest} />
