---
/**
 * Drawer, a panel that slides over the page from the right (a modal
 * <dialog>). Any element with `data-drawer-open="<id>"` opens it; Escape, the
 * close button or a click outside closes it, and focus returns to the opener.
 */
import type { HTMLAttributes } from "astro/types";
import { XIcon } from "@phosphor-icons/react";

type Props = HTMLAttributes<"dialog"> & {
  id: string;
  title: string;
  eyebrow?: string;
  subtitle?: string;
  closeLabel?: string;
};

const { id, title, eyebrow, subtitle, closeLabel = `Close ${title.toLowerCase()}`, ...rest } = Astro.props;
const titleId = `${id}-title`;
---

<dialog
  id={id} class="drawer" aria-labelledby={titleId} data-drawer
  {...rest}
>
  <div class="flex h-full flex-col bg-neutral-0">
    <header class="sticky top-0 z-raised flex items-start justify-between gap-4 border-b border-neutral-200 bg-neutral-0 px-6 py-5 sm:px-8">
      <div>
        {eyebrow && <p class="text-xs font-medium uppercase tracking-widest text-neutral-500">{eyebrow}</p>}
        <h2 id={titleId} class="mt-1 text-xl font-semibold text-neutral-900">{title}</h2>
        {subtitle && <p class="mt-1 text-sm text-neutral-500">{subtitle}</p>}
      </div>
      <button type="button" class="-mr-2 -mt-1 p-2 text-neutral-500 hover:text-neutral-900" aria-label={closeLabel} data-drawer-close>
        <XIcon className="w-5 h-5" aria-hidden="true" />
      </button>
    </header>
    <div class="min-h-0 flex-1 overflow-y-auto px-6 py-7 sm:px-8">
      <slot />
    </div>
  </div>
</dialog>

<script>
  document.addEventListener("astro:page-load", () => {
    document.querySelectorAll<HTMLDialogElement>("dialog[data-drawer]").forEach((dialog) => {
      if (dialog.dataset.wired) return;
      dialog.dataset.wired = "true";
      let opener: HTMLElement | null = null;
      document.querySelectorAll<HTMLElement>(`[data-drawer-open="${dialog.id}"]`).forEach((trigger) =>
        trigger.addEventListener("click", () => {
          opener = trigger;
          dialog.showModal();
        })
      );
      dialog.querySelector("[data-drawer-close]")?.addEventListener("click", () => dialog.close());
      dialog.addEventListener("click", (event) => {
        if (event.target === dialog) dialog.close();
      });
      dialog.addEventListener("close", () => opener?.focus());
    });
  });
</script>
