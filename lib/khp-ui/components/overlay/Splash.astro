---
/**
 * Splash, every time the site loads (KHP §5.8): the mark's green over the
 * whole window, the mark's pieces flying in from past its edges and settling,
 * then, once the page has loaded, flying back out while the green fades, so
 * the page opens through the motion.
 *
 * Built to cost nothing (KHP §7.7): no player, no request, no bundle. The
 * pieces are small inline SVGs moved only by `transform` and the window faded
 * only by `opacity`, both on the compositor, so the motion stays smooth while
 * the page is still loading and on a slow phone. One inline script shows it,
 * waits for the load and starts the exit; a CSS-only cap hides it after
 * `timing.max` even if that script never gets there.
 *
 * Shown only with script, and never under reduced motion or Data Saver
 * (KHP §7.8). A view-transition swap is not a load, so moving between pages
 * never shows it. Hidden from screen readers; it holds no controls.
 */
export interface SplashPiece {
  /** "full" pops in at the end and shrinks out first; "moon" flies. */
  kind: "moon" | "full";
  /** Order: a piece's delay is `i` times the stagger. */
  i: number;
  /** The piece's own SVG, drawn with the `splash-lit` and `splash-unlit` classes. */
  svg: string;
  /** Its centre and width, as percentages of the mark's box. */
  x: number;
  y: number;
  size: number;
  /** The unit direction it flies in from and out to. */
  dx: number;
  dy: number;
}

export interface SplashTiming {
  stagger: number;
  fly: number;
  popDelay: number;
  pop: number;
  hold: number;
  outStagger: number;
  out: number;
  max: number;
}

interface Props {
  pieces: SplashPiece[];
  /** Milliseconds. */
  timing: SplashTiming;
}

const { pieces, timing } = Astro.props;
const vars = [
  `--splash-stagger:${timing.stagger}ms`,
  `--splash-fly:${timing.fly}ms`,
  `--splash-pop-delay:${timing.popDelay}ms`,
  `--splash-pop:${timing.pop}ms`,
  `--splash-out-stagger:${timing.outStagger}ms`,
  `--splash-out:${timing.out}ms`,
  `--splash-max:${timing.max}ms`,
].join(";");
const hold = timing.hold;
const leaveAfter = timing.out + (pieces.length - 1) * timing.outStagger;
---

<div class="splash" data-splash aria-hidden="true" style={vars}>
  <script is:inline define:vars={{ hold, leaveAfter }}>
    // Runs as the page parses, before it paints. A view-transition swap runs it
    // again in the same window; the flag skips it there.
    (function (splash) {
      if (window.__khpSplash) return;
      window.__khpSplash = true;
      var media = window.matchMedia;
      if (media && media("(prefers-reduced-motion: reduce)").matches) return;
      if (navigator.connection && navigator.connection.saveData) return;
      splash.setAttribute("data-show", "");
      var start = Date.now();
      function leave() {
        if (splash.hasAttribute("data-leaving")) return;
        splash.setAttribute("data-leaving", "");
        setTimeout(function () { splash.remove(); }, leaveAfter + 50);
      }
      // Leave once the page has loaded and the mark has come together.
      function loaded() { setTimeout(leave, Math.max(0, hold - (Date.now() - start))); }
      if (document.readyState === "complete") loaded();
      else window.addEventListener("load", loaded, { once: true });
    })(document.currentScript.parentElement);
  </script>
  <div class="splash-mark">
    {pieces.map((piece) => (
      <div
        class:list={["splash-piece", piece.kind === "full" && "splash-full"]}
        style={`--x:${piece.x};--y:${piece.y};--size:${piece.size};--dx:${piece.dx};--dy:${piece.dy};--i:${piece.i}`}
        set:html={piece.svg}
      />
    ))}
  </div>
</div>
