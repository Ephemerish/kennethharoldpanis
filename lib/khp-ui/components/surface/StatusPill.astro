---
/**
 * StatusPill, a state in words (Completed, In Progress): a project's status on
 * its card and page, a badge on an article. One size.
 */
interface Props {
  variant: "brand" | "neutral" | "success" | "warning" | "error";
  class?: string;
}

const { variant, class: extraClass = "" } = Astro.props as Props;

const variantClass = {
  brand: "bg-brand-700 text-neutral-0",
  neutral: "bg-neutral-100/95 text-neutral-700 border border-neutral-200",
  success: "bg-success-100 text-success-800 border border-success-200",
  warning: "bg-warning-100 text-warning-800 border border-warning-200",
  error: "bg-error-100 text-error-800 border border-error-200",
}[variant];
---

<span class:list={[
  "inline-flex items-center gap-1.5 text-xs sm:text-sm font-semibold",
  "px-3 py-1.5 shadow-sm",
  variantClass,
  extraClass,
]}>
  <slot />
</span>
