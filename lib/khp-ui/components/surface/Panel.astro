---
/**
 * Panel, a bordered box with a header strip, split into PanelSections: the
 * project overview. One look for every "facts at a glance" block.
 */
import type { Icon } from "@phosphor-icons/react";
import { cn } from "../../utils/cn";

interface Props {
  title: string;
  Icon?: Icon;
  class?: string;
}

const { title, Icon, class: className } = Astro.props;
---

<section class={cn("border border-neutral-200 bg-neutral-0 shadow-sm", className)}>
  <div class="flex items-center gap-2 px-6 sm:px-8 py-3.5 bg-neutral-50 border-b border-neutral-200">
    {Icon && <Icon className="w-4 h-4 text-brand-500" aria-hidden="true" />}
    <span class="text-sm font-semibold text-neutral-700 tracking-tight">{title}</span>
  </div>
  <slot />
</section>
