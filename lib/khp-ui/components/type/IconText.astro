---
/** IconText, an icon beside a few words: a date, a read time, a place. */
import type { Icon } from "@phosphor-icons/react";
import type { HTMLAttributes } from "astro/types";
import { cn } from "../../utils/cn";

type Props = HTMLAttributes<"span"> & {
  Icon: Icon;
  as?: string;
  /** Icon size: "sm" 14px, "md" 16px, "lg" 20px. */
  iconSize?: "sm" | "md" | "lg";
  /** For `as="time"`: the machine-readable date. */
  datetime?: string;
  class?: string;
};

const { Icon, as = "span", iconSize = "md", class: className, ...rest } = Astro.props;
const Tag = as as "span";
const iconClass = { sm: "w-3.5 h-3.5", md: "w-4 h-4", lg: "w-5 h-5" }[iconSize];
---

<Tag
  class={cn("inline-flex items-center gap-1.5", className)}
  {...rest}
>
  <Icon className={cn(iconClass, "shrink-0")} aria-hidden="true" />
  <slot />
</Tag>
